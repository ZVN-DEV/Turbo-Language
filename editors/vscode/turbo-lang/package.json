{
    "name": "turbo-lang",
    "displayName": "Turbo Language",
    "description": "Syntax highlighting and language support for the Turbo programming language",
    "version": "0.3.0",
    "publisher": "zvn-dev",
    "engines": { "vscode": "^1.80.0" },
    "categories": ["Programming Languages"],
    "contributes": {
        "languages": [{
            "id": "turbo",
            "aliases": ["Turbo", "turbo"],
            "extensions": [".tb"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "turbo",
            "scopeName": "source.turbo",
            "path": "./syntaxes/turbo.tmLanguage.json"
        }]
    }
}
