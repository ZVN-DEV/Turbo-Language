{
    "scopeName": "source.turbo",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#functions" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#constants" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                { "name": "comment.line.double-slash.turbo", "match": "//.*$" },
                { "name": "comment.block.turbo", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#comments" }] }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.turbo",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "name": "constant.character.escape.turbo", "match": "\\\\." },
                        { "name": "meta.embedded.expression.turbo", "begin": "\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                { "name": "keyword.control.turbo", "match": "\\b(if|else|while|for|in|match|return|await|spawn|async|break|continue|defer)\\b" },
                { "name": "keyword.declaration.turbo", "match": "\\b(fn|let|mut|const|struct|enum|type|impl|trait|import|from|agent|tool|unsafe)\\b" },
                { "name": "keyword.other.turbo", "match": "\\b(ok|err|some|none)\\b" }
            ]
        },
        "types": {
            "patterns": [
                { "name": "storage.type.turbo", "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|str|Future)\\b" }
            ]
        },
        "functions": {
            "patterns": [
                { "name": "entity.name.function.turbo", "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()" },
                { "name": "support.function.builtin.turbo", "match": "\\b(print|len|push|abs|min|max|to_str|to_json|assert|assert_eq|assert_ne|panic|map|filter|reduce|split|trim|upper|lower|replace|starts_with|ends_with|char_at|read_line|read_file|write_file|pow|sqrt|sleep|http_get|http_post|hashmap|hashmap_get|hashmap_set|hashmap_keys|channel|mutex)\\b" }
            ]
        },
        "numbers": {
            "patterns": [
                { "name": "constant.numeric.float.turbo", "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b" },
                { "name": "constant.numeric.integer.turbo", "match": "\\b[0-9][0-9_]*\\b" }
            ]
        },
        "operators": {
            "patterns": [
                { "name": "keyword.operator.turbo", "match": "\\|>|=>|->|\\.\\.|\\.\\?|\\?\\?|[+\\-*/%=<>!&|]" }
            ]
        },
        "constants": {
            "patterns": [
                { "name": "constant.language.turbo", "match": "\\b(true|false|none)\\b" },
                { "name": "variable.language.turbo", "match": "\\bself\\b" }
            ]
        }
    }
}
