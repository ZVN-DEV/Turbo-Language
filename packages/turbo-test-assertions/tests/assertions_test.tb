import {
    assert_true, assert_false,
    assert_int_eq, assert_gt, assert_ge, assert_lt, assert_le,
    assert_str_eq, assert_contains, assert_not_contains,
    assert_starts_with, assert_ends_with, assert_empty, assert_not_empty,
    assert_ok, assert_err
} from "../src/lib"

@test fn test_booleans() {
    assert_true(1 + 1 == 2, "arithmetic")
    assert_false(1 + 1 == 3, "arithmetic")
}

@test fn test_int_comparisons() {
    assert_int_eq(6 * 7, 42)
    assert_gt(10, 3)
    assert_ge(3, 3)
    assert_lt(3, 10)
    assert_le(3, 3)
}

@test fn test_strings() {
    assert_str_eq("turbo" + "lang", "turbolang")
    assert_contains("hello world", "world")
    assert_not_contains("hello world", "xyz")
    assert_starts_with("https://turbolang.dev", "https")
    assert_ends_with("main.tb", ".tb")
    assert_empty("")
    assert_not_empty("x")
}

fn ok_result() -> i64 ! str { ok(7) }
fn err_result() -> i64 ! str { err("boom") }

@test fn test_results() {
    assert_ok(ok_result())
    assert_err(err_result())
}
