# Fuzz corpus: keep the checked-in README + seed corpus, but ignore
# runtime-written findings (crash/divergence repros) except the .gitkeep.
fuzz/corpus/findings/*
!fuzz/corpus/findings/.gitkeep
fuzz/artifacts/
