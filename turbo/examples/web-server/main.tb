// Turbo HTTP Server Demo
// Run with: turbo run examples/web-server/main.tb
// Then visit http://localhost:8080 in your browser
// or use: curl http://localhost:8080

fn main() {
    let app = http_server(8080)

    route(app, "GET", "/", |req: str| -> str {
        respond(200, "Hello from Turbo!")
    })

    route(app, "GET", "/api/status", |req: str| -> str {
        respond(200, json_stringify("status", "ok"))
    })

    route(app, "POST", "/api/echo", |req: str| -> str {
        let body = request_body(req)
        respond(200, body)
    })

    print("Server running on http://localhost:8080")
    print("Try: curl http://localhost:8080")
    print("Try: curl http://localhost:8080/api/status")
    print("Try: curl -X POST -d 'hello world' http://localhost:8080/api/echo")
    http_listen(app)
}
