fn add(a: i64, b: i64) -> i64 { a + b }
fn sub(a: i64, b: i64) -> i64 { a - b }
fn fib(n: i64) -> i64 {
    if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }
}
fn main() {
    print("=== Turbo All Features Test ===")
    print(add(10, 20))
    print(sub(100, 58))
    print(fib(10))
    let mut counter = 0
    while counter < 5 {
        counter += 1
    }
    print(counter)
    let x = if true { 42 } else { 0 }
    print(x)
    print(-7)
    print(3.14)
    print(true)
    print(false)
    let a = 10 > 5 && 3 < 7
    print(a)
    print(!false)
}
