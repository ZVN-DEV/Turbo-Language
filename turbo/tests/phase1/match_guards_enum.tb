type Shape { Circle(f64), Rect(f64, f64) }

fn describe(s: Shape) -> str {
    match s {
        Circle(r) if r > 10.0 => "big"
        Circle(r) => "small"
        Rect(w, h) if w == h => "square"
        Rect(w, h) => "rect"
    }
}

fn main() {
    print(describe(Shape.Circle(15.0)))
    print(describe(Shape.Circle(3.0)))
    print(describe(Shape.Rect(5.0, 5.0)))
    print(describe(Shape.Rect(3.0, 7.0)))
}
