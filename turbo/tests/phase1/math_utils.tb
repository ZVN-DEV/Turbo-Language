// abs, min, max are now builtins -- test them directly

fn clamp(val: i64, lo: i64, hi: i64) -> i64 {
    min(max(val, lo), hi)
}

fn int_pow(base: i64, exp: i64) -> i64 {
    let mut result = 1
    let mut i = 0
    while i < exp {
        result = result * base
        i += 1
    }
    result
}

fn main() {
    assert(abs(-42) == 42)
    assert(abs(42) == 42)
    assert(max(10, 20) == 20)
    assert(min(10, 20) == 10)
    assert(clamp(150, 0, 100) == 100)
    assert(clamp(-5, 0, 100) == 0)
    assert(clamp(50, 0, 100) == 50)
    assert(int_pow(2, 10) == 1024)
    assert(int_pow(3, 5) == 243)
    print("All math utils passed!")
}
