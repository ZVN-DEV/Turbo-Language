fn fizzbuzz(n: i64) {
    let mut i = 1
    while i <= n {
        if i % 15 == 0 {
            print("FizzBuzz")
        } else {
            if i % 3 == 0 {
                print("Fizz")
            } else {
                if i % 5 == 0 {
                    print("Buzz")
                } else {
                    print(i)
                }
            }
        }
        i += 1
    }
}

fn main() {
    fizzbuzz(20)
}
