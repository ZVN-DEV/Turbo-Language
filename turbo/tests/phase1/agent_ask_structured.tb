tool fn noop(text: str) -> str { text }
resource ctx(id: str) -> str { id }
prompt review(id: str) -> str { id }

agent StructuredAgent {
    model: "mock:structured"
    tools: [noop]
    resources: [ctx]
    prompts: [review]
    output: str
    system: "Return structured output."
}

fn main() {
    let assistant = StructuredAgent {}
    print(assistant.ask_structured("hello structured"))
}
