// Issue #2 — `agent`, `tool`, `resource`, `prompt` are soft keywords.
// They only act as keywords at item-declaration sites (`agent Foo { }`,
// `tool fn f() { }`, `resource r() { }`, `prompt p() { }`). Anywhere else
// — let bindings, for-loop vars, parameter names, field names, expression
// references — they should behave as ordinary identifiers. Before this
// fix, `for agent in roster { }` failed with "expected identifier, found
// 'agent'".

struct Team {
    agent: str,
    tool: i64,
}

fn greet(mut agent: str) -> str {
    agent = upper(agent)
    agent
}

fn main() {
    // Soft keyword as let-binding name
    let agent = "carl"
    let tool = 42
    let resource = true
    let prompt = 3.14

    print(agent)
    print(tool)
    print(resource)
    print(prompt)

    // Soft keyword as for-loop variable (the Carl Code use case)
    let roster: [str] = ["alice", "bob", "carol"]
    for agent in roster {
        print(agent)
    }

    // Soft keyword as struct field name
    let t = Team { agent: "zoe", tool: 7 }
    print(t.agent)
    print(t.tool)

    // Soft keyword as function parameter name (with mut)
    print(greet("shout"))
}
