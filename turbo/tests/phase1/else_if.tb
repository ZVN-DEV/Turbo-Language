fn main() {
    let x = 5
    if x > 10 {
        print("big")
    } else if x > 3 {
        print("medium")
    } else {
        print("small")
    }

    let y = 15
    if y > 10 {
        print("big")
    } else if y > 3 {
        print("medium")
    } else {
        print("small")
    }

    let z = 1
    if z > 10 {
        print("big")
    } else if z > 3 {
        print("medium")
    } else {
        print("small")
    }
}
