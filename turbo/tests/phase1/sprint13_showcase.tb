// Sprint 13 Comprehensive Showcase
// Combines ALL features: async runtime, agents, generics, enums, closures, etc.

// --- Agent definitions ---
tool fn analyze(data: str) -> str {
    "Analysis of: {data}"
}

tool fn summarize(text: str) -> str {
    "Summary: {text}"
}

agent DataAssistant {
    model: "claude-sonnet"
    tools: [analyze, summarize]
    system: "You are a data analysis assistant."
}

// --- Data-carrying enums ---
type TaskStatus {
    Pending,
    Running(i64),
    Done(i64),
}

fn status_label(s: TaskStatus) -> str {
    match s {
        Pending => "pending"
        Running(id) => "running"
        Done(result) => "done"
    }
}

// --- Generics ---
fn first<T>(a: T, b: T) -> T { a }
fn second<A, B>(a: A, b: B) -> B { b }

// --- Struct with methods ---
struct Counter {
    value: i64,
}

impl Counter {
    fn get(self) -> i64 {
        self.value
    }
}

// --- Higher-order functions ---
fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn make_adder(n: i64) -> fn(i64) -> i64 {
    |x: i64| -> i64 { x + n }
}

// --- Async with real sleep ---
async fn delayed_value(ms: i64, val: i64) -> i64 {
    await sleep(ms)
    val
}

// --- Main: exercise everything ---
async fn main() {
    print("=== Sprint 13 Showcase ===")

    // 1. Agent instantiation and field access
    let assistant = DataAssistant {}
    print(assistant.model)
    print(assistant.system)
    print(analyze("turbo data"))
    print(summarize("turbo summary"))

    // 2. Enums and pattern matching
    print(status_label(TaskStatus.Pending))
    print(status_label(TaskStatus.Running(1)))
    print(status_label(TaskStatus.Done(42)))

    // 3. Generics
    print(first(10, 20))
    print(second("hello", 99))

    // 4. Struct with methods
    let c = Counter { value: 42 }
    print(c.get())

    // 5. Closures with capture
    let add5 = make_adder(5)
    print(apply(add5, 10))

    // 6. Arrays and iteration
    let nums = [10, 20, 30, 40, 50]
    let mut total = 0
    for n in nums {
        total += n
    }
    print(total)

    // 7. String interpolation
    let lang = "Turbo"
    print("Language: {lang}")

    // 8. Real async: concurrent spawn with sleep
    let a = spawn delayed_value(10, 100)
    let b = spawn delayed_value(10, 200)
    let sum = await a + await b
    print(sum)

    // 9. Math
    print(fib(10))

    // 10. Boolean logic
    let x = true
    let y = false
    print(x && !y)

    print("=== All features working ===")
}

fn fib(n: i64) -> i64 {
    if n <= 1 { n }
    else { fib(n - 1) + fib(n - 2) }
}
