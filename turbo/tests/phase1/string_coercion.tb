fn main() {
    // str + int requires explicit to_str()
    print("count: " + to_str(42))
    // str + bool requires explicit to_str()
    print("flag: " + to_str(true))
    // str + float requires explicit to_str()
    print("pi: " + to_str(3.14))
    // int + str requires explicit to_str()
    print(to_str(10) + " items")
    // bool + str requires explicit to_str()
    print(to_str(false) + " alarm")
    // float + str requires explicit to_str()
    print(to_str(2.72) + " is e")
}
