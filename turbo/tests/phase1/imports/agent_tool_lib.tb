// Issue #4 reproducer — library side.
// Defines tool fns AND an agent that references them. The importer only
// names the agent in its import list; the tool fns must be pulled in
// automatically because agents resolve their tools by name at sema time.

tool fn lib_tool_echo(msg: str) -> str {
    msg
}

tool fn lib_tool_shout(msg: str) -> str {
    upper(msg)
}

agent EchoBot {
    model: "mock:echo"
    tools: [lib_tool_echo, lib_tool_shout]
    system: "A simple echo bot."
}

fn run_bot(input: str) -> str {
    let bot = EchoBot {}
    bot.ask(input)
}
