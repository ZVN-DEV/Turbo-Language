// Regression: a struct array iterated by several for-loops must not double-free
// its elements. The loop variable is a borrow of an array element; releasing it
// at scope end (once per loop) freed the same Task struct multiple times,
// causing a nondeterministic heap-corruption SIGTRAP on teardown.
struct Task { id: i64, title: str, done: bool }

fn count_done(tasks: [Task]) -> i64 {
    let mut n = 0
    for t in tasks { if t.done { n += 1 } }
    n
}

fn count_open(tasks: [Task]) -> i64 {
    let mut n = 0
    for t in tasks { if !t.done { n += 1 } }
    n
}

fn main() {
    let tasks = [
        Task { id: 1, title: "a", done: true },
        Task { id: 2, title: "b", done: false },
        Task { id: 3, title: "c", done: true }
    ]
    for t in tasks { print("#{t.id} {t.title}") }
    print("done={count_done(tasks)} open={count_open(tasks)}")
}
