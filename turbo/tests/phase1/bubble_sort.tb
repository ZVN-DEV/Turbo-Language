fn main() {
    let mut arr = [5, 3, 1, 4, 2]
    let n = len(arr)
    for i in 0..n {
        for j in 0..(n - 1) {
            if arr[j] > arr[j + 1] {
                let tmp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = tmp
            }
        }
    }
    for x in arr { print(x) }
}
