tool fn noop(text: str) -> str { text }
resource ctx(id: str) -> str { id }
prompt review(id: str) -> str { id }

agent EchoAgent {
    model: "mock:echo"
    tools: [noop]
    resources: [ctx]
    prompts: [review]
    output: str
    system: "Echo exactly what the user asks."
}

fn main() {
    let assistant = EchoAgent {}
    print(assistant.ask("hello from turbo"))
}
