// BL-11: optional payloads are reinterpreted before rendering, so non-int
// payloads (float, bool) no longer render garbage. `some(x)` / `none`.
fn main() {
    let i: i64? = some(42)
    print(i)

    let f: float? = some(3.5)
    print(f)
    print("f = {f}")

    let b: bool? = some(true)
    print(b)

    let n: float? = none
    print(n)
}
