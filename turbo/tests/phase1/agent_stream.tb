tool fn noop(text: str) -> str { text }
resource ctx(id: str) -> str { id }
prompt review(id: str) -> str { id }

agent StreamAgent {
    model: "mock:echo"
    tools: [noop]
    resources: [ctx]
    prompts: [review]
    output: str
    system: "Echo the prompt."
}

fn main() {
    let assistant = StreamAgent {}
    let chunks = assistant.stream("hello from turbo")
    print(len(chunks))
    print(chunks[0])
    print(chunks[1])
    print(chunks[2])
}
