fn collatz_steps(n: i64) -> i64 {
    let mut current = n
    let mut steps = 0
    while current != 1 {
        if current % 2 == 0 {
            current = current / 2
        } else {
            current = current * 3 + 1
        }
        steps += 1
    }
    steps
}

fn main() {
    print(collatz_steps(27))
    assert(collatz_steps(1) == 0)
    assert(collatz_steps(2) == 1)
    assert(collatz_steps(27) == 111)
    print("Collatz verified!")
}
