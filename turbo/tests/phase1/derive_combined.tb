@derive(Eq, Clone)
struct Point { x: i64, y: i64 }

fn main() {
    let a = Point { x: 1, y: 2 }
    let b = Point { x: 1, y: 2 }
    let c = Point { x: 3, y: 4 }

    if a == b { print("a equals b") }
    if a != c { print("a not equals c") }

    let d = clone(a)
    print(d.x)
    print(d.y)

    if a == d { print("a equals clone") }
}
