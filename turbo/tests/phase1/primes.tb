fn is_prime(n: i64) -> bool {
    if n < 2 { return false }
    let mut i = 2
    while i * i <= n {
        if n % i == 0 {
            return false
        }
        i += 1
    }
    true
}

fn main() {
    let mut n = 2
    let mut count = 0
    while n <= 100 {
        if is_prime(n) {
            print(n)
            count += 1
        }
        n += 1
    }
    assert(count == 25)
    print("Found 25 primes under 100!")
}
