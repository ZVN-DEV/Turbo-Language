type Shape {
    Circle(f64),
    Rect(f64, f64),
    Point,
}

fn area(s: Shape) -> f64 {
    match s {
        Circle(r) => 3.14 * r * r
        Rect(w, h) => w * h
        Point => 0.0
    }
}

fn main() {
    print(area(Shape.Circle(5.0)))
    print(area(Shape.Rect(3.0, 4.0)))
    print(area(Shape.Point))
}
