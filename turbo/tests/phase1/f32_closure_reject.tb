// Regression: an f32 closure parameter must fail loud (clean sema error)
// instead of panicking the Cranelift backend with a register-class mismatch.
fn apply(f: fn(f32) -> f32, x: f32) -> f32 {
    f(x)
}

fn main() {
    let y: f32 = 3.5
    let g = |x: f32| -> f32 { x * x }
    print(apply(g, y))
}
