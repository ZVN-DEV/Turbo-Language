fn main() {
    let nums = [1, 2, 3, 4, 5, 6]
    // inferred-type predicate (regression: was a Cranelift verifier error)
    let evens = filter(nums, |x| x % 2 == 0)
    for v in evens { print(v) }
    print("--")
    // explicitly-typed predicate
    let big = filter(nums, |x: i64| -> bool { x > 3 })
    for v in big { print(v) }
}
