fn safe_sqrt(n: i64) -> i64 ! str {
    if n < 0 {
        err("negative input")
    } else {
        ok(n)
    }
}

fn main() {
    match safe_sqrt(25) {
        ok(v) => print(v)
        err(e) => print(e)
    }
    match safe_sqrt(-1) {
        ok(v) => print(v)
        err(e) => print(e)
    }
}
