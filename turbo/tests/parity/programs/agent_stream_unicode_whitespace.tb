// Parity xfail: agent.stream() tokenization diverges on Unicode whitespace.
//
// This test is pinned as an EXPECTED DIVERGENCE between JIT and AOT.
// See the sibling `.expect_divergence` file.
//
// Background
// ----------
// `rt_agent_stream` splits the agent's response on whitespace and returns
// a turbo string array. The JIT runtime (Rust, `runtime.rs`) uses
// `str::split_whitespace()`, which recognizes the full Unicode
// White_Space property — that includes U+00A0 NO-BREAK SPACE,
// U+2028 LINE SEPARATOR, U+3000 IDEOGRAPHIC SPACE, and others. The AOT
// C runtime (`turbo_rt.c`:rt_agent_stream) only splits on the ASCII set
// (' \t\n\r\f\v'), so multi-byte UTF-8 whitespace is treated as
// part of the preceding token.
//
// Pinned input: "alpha<NBSP>beta gamma" (the byte between alpha and beta
// is U+00A0, encoded as 0xC2 0xA0).
//
// Expected behavior:
//   JIT  (Rust split_whitespace): 3 tokens -> prints "3"
//   AOT  (C ASCII split):         2 tokens -> prints "2"
//
// When this test STOPS diverging — i.e. both backends print the same
// number — the parity runner will fail with "no longer diverges",
// meaning someone aligned the two backends. At that point: delete the
// `.expect_divergence` sibling file so this test becomes a regular
// parity test, and update the PARITY-NOTE comment in turbo_rt.c.
agent EchoAgent {
    model: "mock:echo"
    output: str
    system: "Echo the prompt."
}

fn main() {
    let assistant = EchoAgent {}
    // The literal byte between "alpha" and "beta" below is U+00A0
    // (NO-BREAK SPACE, UTF-8 0xC2 0xA0). Do NOT "clean up" the source.
    let chunks = assistant.stream("alpha beta gamma")
    print(len(chunks))
}
