// Parity: agent.ask_structured() against the mock:echo provider.
//
// Exercises rt_agent_ask_structured in both the JIT runtime (Rust)
// and the AOT C runtime (turbo_rt.c). For mock:echo both backends
// return the merged "<prompt>\nReturn only valid JSON for output type
// `<type>` matching this schema:\n<schema>" string verbatim, so the
// stdout of the two runtimes must be byte-identical.
agent EchoStructuredAgent {
    model: "mock:echo"
    output: str
    system: "Echo the structured prompt."
}

fn main() {
    let assistant = EchoStructuredAgent {}
    let result = assistant.ask_structured("hi")
    print(result)
}
