// Parity: agent.stream() against the mock:echo provider.
//
// Exercises rt_agent_stream in both the JIT runtime (Rust) and the
// AOT C runtime (turbo_rt.c). For mock:echo both backends return the
// raw user prompt and split it on whitespace into a turbo string array.
agent EchoAgent {
    model: "mock:echo"
    output: str
    system: "Echo the prompt."
}

fn main() {
    let assistant = EchoAgent {}
    let chunks = assistant.stream("hello from turbo")
    print(len(chunks))
    print(chunks[0])
    print(chunks[1])
    print(chunks[2])
}
