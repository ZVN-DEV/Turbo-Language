// Identical seeded operation trace for integer and precomputed string keys.
// Hashing/storage implementations differ; this measures language+runtime costs.
fn main() {
    let configured = env_get("TURBO_BENCH_STEPS")
    let n = if configured == "" { 2097152 } else {
        match str_to_int(configured) {
            ok(value) => value
            err(e) => 0
        }
    }
    assert(n > 0)
    let mut keys: [str] = []
    let mut i = 0
    while i < 4096 {
        keys.push("k" + to_str(i))
        i += 1
    }
    let ints: HashMap<int, int> = hashmap()
    let strings: HashMap<str, int> = hashmap()
    let mut state: i64 = 7
    i = 0
    while i < n {
        state = (state * 1103515245 + 12345) % 2147483648
        let key = state % 4096
        let name = keys[key]
        hashmap_set(ints, key, (hashmap_get(ints, key) ?? 0) + 1)
        hashmap_set(strings, name, (hashmap_get(strings, name) ?? 0) + 1)
        if i % 7 == 0 {
            let removed = (key + 17) % 4096
            hashmap_remove(ints, removed)
            hashmap_remove(strings, keys[removed])
        }
        i += 1
    }
    let mut numeric: i64 = 0
    let mut textual: i64 = 0
    i = 0
    while i < 4096 {
        numeric += (hashmap_get(ints, i) ?? 0) * (i + 1)
        textual += (hashmap_get(strings, keys[i]) ?? 0) * (i + 1)
        i += 1
    }
    print(numeric)
    print(textual)
    print(hashmap_len(ints))
    print(hashmap_len(strings))
}
