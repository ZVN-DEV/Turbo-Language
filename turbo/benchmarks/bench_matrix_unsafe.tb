// Benchmark: Matrix multiplication (150x150) with @unsafe array access
// Measures: nested loops, unchecked array indexing, arithmetic
@unsafe
fn main() {
    let n = 150
    let mut a: [i64] = []
    let mut b: [i64] = []
    let mut c: [i64] = []
    let mut i = 0
    while i < n * n {
        a = push(a, i % 100)
        b = push(b, (i * 3) % 100)
        c = push(c, 0)
        i += 1
    }
    // c = a * b
    let mut row = 0
    while row < n {
        let mut col = 0
        while col < n {
            let mut sum = 0
            let mut k = 0
            while k < n {
                sum = sum + a[row * n + k] * b[k * n + col]
                k += 1
            }
            c[row * n + col] = sum
            col += 1
        }
        row += 1
    }
    // Checksum: sum of all elements
    let mut total = 0
    i = 0
    while i < n * n {
        total = total + c[i]
        i += 1
    }
    print(total)
}
