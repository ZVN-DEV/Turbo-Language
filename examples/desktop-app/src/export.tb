// =============================================================================
// export.tb — Export notes to HTML and PDF formats
//
// Demonstrates:
//   - Pattern matching on export format enum
//   - String interpolation for HTML template generation
//   - Pipe operator for content transformation pipelines
//   - Async file I/O with error propagation (T ! E and ?)
//   - const for embedded CSS (compile-time string)
//   - Struct destructuring in function parameters
//   - Clean separation: parse -> transform -> serialize
// =============================================================================

import { Path, File } from "std/fs"
import { log } from "turbo/log"
import {
  Note, ExportConfig, ExportFormat, PageSize, AppError
} from "./models"
import { MarkdownParser, MarkdownRenderer, MarkdownDoc } from "./markdown"

// =============================================================================
// Embedded Stylesheets (compile-time constants)
// =============================================================================

/// Default CSS for exported HTML documents.
/// Embedded at compile time — no runtime file loading needed.
const DEFAULT_CSS: str = """
  :root {
    --font-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, sans-serif;
    --font-mono: "SF Mono", "Fira Code", "JetBrains Mono", Consolas, monospace;
    --color-text: #1a1a2e;
    --color-bg: #ffffff;
    --color-link: #2563eb;
    --color-code-bg: #f1f5f9;
    --color-border: #e2e8f0;
    --color-heading: #0f172a;
    --color-blockquote: #64748b;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text);
    background: var(--color-bg);
    max-width: 48rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  h1, h2, h3, h4, h5, h6 {
    color: var(--color-heading);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
    font-weight: 600;
  }

  h1 { font-size: 2rem; border-bottom: 2px solid var(--color-border); padding-bottom: 0.5rem; }
  h2 { font-size: 1.5rem; }
  h3 { font-size: 1.25rem; }
  h4 { font-size: 1.1rem; }

  p { margin-bottom: 1rem; }

  a { color: var(--color-link); text-decoration: none; }
  a:hover { text-decoration: underline; }

  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--color-code-bg);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  pre {
    background: var(--color-code-bg);
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.25rem;
    border: 1px solid var(--color-border);
  }

  pre code {
    background: none;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  blockquote {
    border-left: 4px solid var(--color-link);
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    color: var(--color-blockquote);
    background: var(--color-code-bg);
    border-radius: 0 8px 8px 0;
  }

  ul, ol { margin: 0.5rem 0 1rem 1.5rem; }
  li { margin-bottom: 0.35rem; }
  li > ul, li > ol { margin-top: 0.25rem; margin-bottom: 0; }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.95rem;
  }

  th, td {
    border: 1px solid var(--color-border);
    padding: 0.6rem 0.8rem;
    text-align: left;
  }

  th {
    background: var(--color-code-bg);
    font-weight: 600;
  }

  hr {
    border: none;
    border-top: 2px solid var(--color-border);
    margin: 2rem 0;
  }

  img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1rem 0;
  }

  input[type="checkbox"] {
    margin-right: 0.5rem;
    transform: scale(1.15);
  }

  @media print {
    body { max-width: none; padding: 0; }
    pre { white-space: pre-wrap; word-wrap: break-word; }
    a { color: inherit; text-decoration: underline; }
    h1, h2, h3 { page-break-after: avoid; }
  }
  """

/// Dark theme CSS variant
const DARK_CSS: str = """
  :root {
    --color-text: #e2e8f0;
    --color-bg: #0f172a;
    --color-link: #60a5fa;
    --color-code-bg: #1e293b;
    --color-border: #334155;
    --color-heading: #f1f5f9;
    --color-blockquote: #94a3b8;
  }
  """

// =============================================================================
// HTML Exporter
// =============================================================================

pub struct HtmlExporter {}

impl HtmlExporter {
  /// Export a note to a standalone HTML file
  pub async fn export(note: Note, config: ExportConfig) -> () ! AppError {
    guard config.format == ExportFormat.Html else {
      return err(AppError.ExportError("html", "Invalid format for HTML exporter"))
    }

    log.info("Exporting to HTML", { title: note.title, path: config.output_path.to_str() })

    // Parse markdown to AST, then render to HTML
    let doc = MarkdownParser.parse(note.content)
    let body_html = MarkdownRenderer.render(doc)

    // Build the frontmatter section if requested
    let frontmatter_html = if config.include_frontmatter && !note.metadata.tags.is_empty() {
      let tags = note.metadata.tags
        .map((t) => "<span class=\"tag\">{t}</span>")
        .join(" ")
      "<div class=\"frontmatter\"><p class=\"tags\">{tags}</p></div>\n"
    } else {
      ""
    }

    // Build the metadata footer if requested
    let metadata_html = if config.include_metadata {
      let date = note.updated_at.format("YYYY-MM-DD HH:mm")
      let words = note.word_count()
      let reading = note.reading_time()
      "<footer class=\"metadata\">"
      ++ "<p>Last updated: {date} | {words} words | {reading} min read</p>"
      ++ "</footer>\n"
    } else {
      ""
    }

    // Select CSS theme
    let css = match config.css_theme {
      "dark" => "{DEFAULT_CSS}\n{DARK_CSS}"
      _      => DEFAULT_CSS
    }

    // Assemble the complete HTML document
    let html = build_html_document(
      title: note.title,
      css: css,
      body: "{frontmatter_html}{body_html}\n{metadata_html}",
    )

    // Write to disk
    File.write_string(config.output_path, html)
      .map_err((e) => AppError.ExportError("html", "Failed to write file: {e}"))?

    log.info("HTML export complete", {
      path: config.output_path.to_str(),
      size: html.len(),
    })
  }
}

/// Build a complete HTML5 document from parts
fn build_html_document(title: str, css: str, body: str) -> str {
  """<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content="TurboNotes">
  <title>{title}</title>
  <style>
{css}
  </style>
</head>
<body>
  <article>
{body}
  </article>
</body>
</html>"""
}

// =============================================================================
// PDF Exporter
// =============================================================================

pub struct PdfExporter {}

impl PdfExporter {
  /// Export a note to PDF via native rendering.
  /// On macOS this uses Core Graphics; on Linux, Cairo; on Windows, Direct2D.
  pub async fn export(note: Note, config: ExportConfig) -> () ! AppError {
    guard config.format == ExportFormat.Pdf else {
      return err(AppError.ExportError("pdf", "Invalid format for PDF exporter"))
    }

    log.info("Exporting to PDF", {
      title: note.title,
      path: config.output_path.to_str(),
      page_size: "{config.page_size}",
    })

    // Parse markdown to AST
    let doc = MarkdownParser.parse(note.content)

    // Calculate page dimensions in points (72 dpi)
    let (width_mm, height_mm) = config.page_size.dimensions_mm()
    let width_pt = width_mm * 2.8346   // mm to points
    let height_pt = height_mm * 2.8346

    // Create a PDF document builder
    let mut pdf = PdfDocument.new(
      title: note.title,
      author: "TurboNotes",
      page_width: width_pt,
      page_height: height_pt,
    )

    // Margin configuration (in points)
    let margin = PdfMargins {
      top: 72.0,      // 1 inch
      bottom: 72.0,
      left: 54.0,     // 0.75 inch
      right: 54.0,
    }

    // Render each block to the PDF
    let mut y_position = margin.top

    for block in doc.blocks {
      let (rendered_height, needs_page_break) = self.render_block_to_pdf(
        pdf, block, margin, y_position, width_pt, height_pt, config.syntax_highlight,
      )

      if needs_page_break {
        pdf.new_page()
        y_position = margin.top
        // Re-render on new page
        let (h, _) = self.render_block_to_pdf(
          pdf, block, margin, y_position, width_pt, height_pt, config.syntax_highlight,
        )
        y_position += h
      } else {
        y_position += rendered_height
      }
    }

    // Optional metadata footer on the last page
    if config.include_metadata {
      let date = note.updated_at.format("YYYY-MM-DD")
      let words = note.word_count()
      pdf.set_font("body", size: 9.0, color: "#94a3b8")
      pdf.draw_text(
        "{note.title} | {date} | {words} words",
        x: margin.left,
        y: height_pt - margin.bottom + 20.0,
      )
    }

    // Write the PDF to disk
    let bytes = pdf.finalize()
    File.write_bytes(config.output_path, bytes)
      .map_err((e) => AppError.ExportError("pdf", "Failed to write file: {e}"))?

    log.info("PDF export complete", {
      path: config.output_path.to_str(),
      pages: pdf.page_count(),
      size: bytes.len(),
    })
  }

  /// Render a single block element to the PDF, returning (height, needs_page_break)
  fn render_block_to_pdf(
    self,
    pdf: PdfDocument,
    block: Block,
    margin: PdfMargins,
    y: f64,
    page_width: f64,
    page_height: f64,
    syntax_highlight: bool,
  ) -> (f64, bool) {
    let content_width = page_width - margin.left - margin.right
    let max_y = page_height - margin.bottom

    match block {
      Heading(level, content) => {
        let size = match level {
          1 => 24.0
          2 => 20.0
          3 => 17.0
          4 => 15.0
          _ => 13.0
        }
        let text = self.inlines_to_plain_text(content)
        let spacing_before = size * 0.8
        let spacing_after = size * 0.4
        let total_height = spacing_before + size + spacing_after

        if y + total_height > max_y {
          return (total_height, true)
        }

        pdf.set_font("heading", size: size, color: "#0f172a")
        pdf.draw_text(text, x: margin.left, y: y + spacing_before)

        if level == 1 {
          pdf.draw_line(
            x1: margin.left, y1: y + spacing_before + size + 4.0,
            x2: margin.left + content_width, y2: y + spacing_before + size + 4.0,
            color: "#e2e8f0", width: 1.5,
          )
        }

        (total_height, false)
      }

      Paragraph(content) => {
        let text = self.inlines_to_plain_text(content)
        pdf.set_font("body", size: 11.0, color: "#1a1a2e")
        let height = pdf.draw_text_wrapped(
          text, x: margin.left, y: y, max_width: content_width,
        )
        let total = height + 12.0  // paragraph spacing
        (total, y + total > max_y)
      }

      CodeBlock(language, code) => {
        let padding = 12.0
        pdf.set_font("mono", size: 10.0, color: "#334155")

        // Draw background rectangle
        let code_height = pdf.measure_text_wrapped(code, max_width: content_width - padding * 2)
        let block_height = code_height + padding * 2

        if y + block_height > max_y {
          return (block_height, true)
        }

        pdf.draw_rect(
          x: margin.left, y: y,
          width: content_width, height: block_height,
          fill: "#f1f5f9", radius: 6.0,
        )

        pdf.draw_text_wrapped(
          code,
          x: margin.left + padding,
          y: y + padding,
          max_width: content_width - padding * 2,
        )

        (block_height + 12.0, false)
      }

      BlockQuote(blocks) => {
        // Draw left border
        let inner_height = 40.0  // Estimated; real implementation would measure
        pdf.draw_rect(
          x: margin.left, y: y,
          width: 4.0, height: inner_height,
          fill: "#2563eb", radius: 2.0,
        )

        // Render inner blocks with left offset
        pdf.set_font("body", size: 11.0, color: "#64748b")
        let text = blocks
          .map((b) => match b { Paragraph(c) => self.inlines_to_plain_text(c), _ => "" })
          .join("\n")
        let height = pdf.draw_text_wrapped(
          text, x: margin.left + 16.0, y: y + 4.0, max_width: content_width - 16.0,
        )

        (height + 16.0, y + height + 16.0 > max_y)
      }

      ThematicBreak => {
        pdf.draw_line(
          x1: margin.left + content_width * 0.1, y1: y + 12.0,
          x2: margin.left + content_width * 0.9, y2: y + 12.0,
          color: "#e2e8f0", width: 1.0,
        )
        (24.0, false)
      }

      _ => {
        // For other block types, fall back to plain text rendering
        (0.0, false)
      }
    }
  }

  /// Convert inline elements to plain text for PDF rendering
  fn inlines_to_plain_text(self, inlines: [Inline]) -> str {
    inlines.map((inline) => {
      match inline {
        Text(t)             => t
        Bold(content)       => self.inlines_to_plain_text(content)
        Italic(content)     => self.inlines_to_plain_text(content)
        BoldItalic(content) => self.inlines_to_plain_text(content)
        Code(c)             => c
        Link(text, _, _)    => self.inlines_to_plain_text(text)
        Image(alt, _, _)    => "[{alt}]"
        Strikethrough(content) => self.inlines_to_plain_text(content)
        LineBreak           => "\n"
        SoftBreak           => " "
        _                   => ""
      }
    }).join("")
  }
}

// =============================================================================
// PDF Document Builder (platform-native abstraction)
// =============================================================================

/// Low-level PDF document builder. In a real implementation, this wraps
/// the platform's native graphics API (Core Graphics, Cairo, Direct2D).
struct PdfDocument {
  title: str
  author: str
  page_width: f64
  page_height: f64
  pages: usize
}

impl PdfDocument {
  fn new(title: str, author: str, page_width: f64, page_height: f64) -> PdfDocument {
    PdfDocument { title, author, page_width, page_height, pages: 1 }
  }

  fn new_page(self) { self.pages += 1 }
  fn page_count(self) -> usize { self.pages }
  fn set_font(self, family: str, size: f64, color: str) {}
  fn draw_text(self, text: str, x: f64, y: f64) {}
  fn draw_text_wrapped(self, text: str, x: f64, y: f64, max_width: f64) -> f64 { 0.0 }
  fn measure_text_wrapped(self, text: str, max_width: f64) -> f64 { 0.0 }
  fn draw_line(self, x1: f64, y1: f64, x2: f64, y2: f64, color: str, width: f64) {}
  fn draw_rect(self, x: f64, y: f64, width: f64, height: f64, fill: str, radius: f64) {}
  fn finalize(self) -> [u8] { [] }
}

/// PDF margin configuration
struct PdfMargins {
  top: f64
  bottom: f64
  left: f64
  right: f64
}

// =============================================================================
// Unified Export API
// =============================================================================

/// Export a note to the specified format. Entry point for all exports.
pub async fn export_note(note: Note, config: ExportConfig) -> () ! AppError {
  match config.format {
    Html => await HtmlExporter.export(note, config)
    Pdf  => await PdfExporter.export(note, config)
  }
}

/// Export multiple notes as a single combined document
pub async fn export_collection(
  notes: [Note],
  config: ExportConfig,
  include_toc: bool = true,
) -> () ! AppError {
  guard !notes.is_empty() else {
    return err(AppError.ExportError("{config.format}", "No notes to export"))
  }

  log.info("Exporting collection", {
    count: notes.len(),
    format: "{config.format}",
    include_toc,
  })

  // Build a combined markdown document
  let mut combined_parts: [str] = []

  // Table of contents
  if include_toc {
    combined_parts.push("# Table of Contents\n")
    for (i, note) in notes.enumerate() {
      let anchor = note.title.to_lowercase().replace(" ", "-")
      combined_parts.push("{i + 1}. [{note.title}](#{anchor})")
    }
    combined_parts.push("\n---\n")
  }

  // Each note separated by a thematic break
  for note in notes {
    combined_parts.push(note.content)
    combined_parts.push("\n---\n")
  }

  let combined_content = combined_parts.join("\n")
  let combined_note = Note {
    ..notes[0],
    title: "TurboNotes Export ({notes.len()} notes)",
    content: combined_content,
  }

  await export_note(combined_note, config)
}
