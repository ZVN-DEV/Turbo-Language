// =============================================================================
// agent.tb — AI writing assistant for TurboNotes
//
// Demonstrates:
//   - tool fn keyword for LLM-callable functions
//   - agent keyword for declaring AI agents
//   - Doc comments (///) for auto-generated tool schemas
//   - Guard statements for input validation
//   - Streaming with for await and async gen
//   - Agent memory configuration
//   - Pipe operator for data transformation
//   - Context binding for tool functions to access editor state
//   - Desktop-native AI integration (no server roundtrip)
// =============================================================================

import { Shared } from "turbo/sync"
import { log } from "turbo/log"
import { Editor } from "./editor"
import { NoteStore } from "./storage"
import { SearchIndex } from "./search"
import {
  Note, NoteMetadata, AppError, SearchQuery
} from "./models"

// =============================================================================
// Tool Context — shared state accessible by all tool functions
// =============================================================================

/// Editor and store references are captured from the agent's context
let editor: Shared<Editor>
let store: Shared<NoteStore>
let search_index: Shared<SearchIndex>

// =============================================================================
// Tool Functions — automatically exposed to the LLM
// =============================================================================

tool fn summarize_text(text: str, max_sentences: u32 = 3) -> str {
  /// Summarize the given text into a concise version
  /// @param text - The text to summarize (typically the current note or selection)
  /// @param max_sentences - Maximum number of sentences in the summary (default: 3)
  guard !text.trim().is_empty() else {
    return "No text provided to summarize."
  }

  // The LLM handles the actual summarization — this tool provides
  // the interface contract and validation. The agent runtime passes
  // the text to the model with appropriate instructions.
  let word_count = text.split_whitespace().count()
  log.debug("Summarizing text", { word_count, max_sentences })

  // Return instruction for the LLM to process
  "__LLM_PROCESS__: Summarize the following text in at most {max_sentences} sentences, preserving key information:\n\n{text}"
}

tool fn expand_section(text: str, style: str = "detailed") -> str {
  /// Expand a short section into a more detailed version
  /// @param text - The text to expand (a brief note, outline item, or stub paragraph)
  /// @param style - Writing style: "detailed", "academic", "casual", or "technical"
  guard !text.trim().is_empty() else {
    return "No text provided to expand."
  }

  let valid_styles = ["detailed", "academic", "casual", "technical"]
  let effective_style = if valid_styles.contains(style) { style } else { "detailed" }

  log.debug("Expanding section", {
    input_length: text.len(),
    style: effective_style,
  })

  "__LLM_PROCESS__: Expand the following text into a more {effective_style} version. Maintain the original meaning and structure while adding depth, examples, and clarity:\n\n{text}"
}

tool fn fix_grammar(text: str, preserve_style: bool = true) -> str {
  /// Fix grammar, spelling, and punctuation errors in the text
  /// @param text - The text to correct
  /// @param preserve_style - Whether to preserve the author's voice and style (default: true)
  guard !text.trim().is_empty() else {
    return "No text provided for grammar correction."
  }

  let style_instruction = if preserve_style {
    "Preserve the author's voice and writing style."
  } else {
    "Use standard formal English."
  }

  log.debug("Fixing grammar", { text_length: text.len(), preserve_style })

  "__LLM_PROCESS__: Fix all grammar, spelling, and punctuation errors in the following text. {style_instruction} Only change what is incorrect — do not rewrite sentences that are already correct:\n\n{text}"
}

tool fn generate_outline(topic: str, depth: u32 = 2) -> str {
  /// Generate a structured markdown outline for a given topic
  /// @param topic - The topic or title to outline
  /// @param depth - Nesting depth of the outline (1-4, default: 2)
  guard !topic.trim().is_empty() else {
    return "No topic provided for outline generation."
  }

  let clamped_depth = depth.clamp(1, 4)

  log.debug("Generating outline", { topic, depth: clamped_depth })

  "__LLM_PROCESS__: Generate a structured markdown outline for the topic \"{topic}\". Use heading levels ## through {'#'.repeat(clamped_depth as usize + 1)} with bullet points under each section. Make the outline comprehensive but concise. Format as valid markdown."
}

tool fn suggest_tags(text: str, existing_tags: [str] = []) -> [str] {
  /// Analyze text and suggest relevant tags for categorization
  /// @param text - The note content to analyze
  /// @param existing_tags - Tags already applied to this note (to avoid duplicates)
  guard !text.trim().is_empty() else {
    return []
  }

  log.debug("Suggesting tags", {
    text_length: text.len(),
    existing_count: existing_tags.len(),
  })

  // Extract keywords from the text as initial candidates
  let word_freq = text
    .to_lowercase()
    .split_whitespace()
    .map((w) => w.trim_matches((c: char) => !c.is_alphanumeric()))
    .filter((w) => w.len() > 3)
    .fold({:} as {str: usize}, (freq, word) => {
      freq[word] = (freq.get(word) ?? 0) + 1
      freq
    })

  // Get the top frequent terms not already in existing tags
  let candidates = word_freq
    |> entries()
    |> filter((word, _) => !existing_tags.contains(word))
    |> sort_by((a, b) => b.1.cmp(a.1))
    |> take(10)
    |> map((word, _) => word)
    |> collect()

  candidates
}

tool fn search_notes(query: str, max_results: u32 = 5) -> [NoteSearchResult] {
  /// Search across all notes to find relevant content
  /// @param query - The search query text
  /// @param max_results - Maximum number of results to return (default: 5)
  guard !query.trim().is_empty() else {
    return []
  }

  let results = search_index.read().search(SearchQuery {
    text: query,
    max_results: max_results as usize,
  })

  match results {
    ok(results) => results.map((r) => NoteSearchResult {
      title: r.note_title,
      snippet: r.snippet,
      relevance: r.score,
    })
    err(e) => {
      log.warn("Agent search failed", { error: e.message() })
      []
    }
  }
}

tool fn get_current_note_context() -> NoteContext {
  /// Get context about the currently open note (title, word count, tags, etc.)
  let editor_state = editor.read().snapshot()
  let content = editor_state.content
  let selected = editor_state.selected_text()

  NoteContext {
    content_length: content.len(),
    word_count: content.split_whitespace().count(),
    line_count: content.lines().count(),
    has_selection: selected.is_some(),
    selected_text: selected,
    selected_word_count: selected.map((s) => s.split_whitespace().count()) ?? 0,
  }
}

// =============================================================================
// Tool Response Types
// =============================================================================

@derive(Debug, Schema, Serialize)
struct NoteSearchResult {
  title: str
  snippet: str
  relevance: f64
}

@derive(Debug, Schema, Serialize)
struct NoteContext {
  content_length: usize
  word_count: usize
  line_count: usize
  has_selection: bool
  selected_text: str?
  selected_word_count: usize
}

// =============================================================================
// Agent Declaration — TurboNotes Writing Assistant
// =============================================================================

agent WritingAssistant {
  model: "claude-sonnet"

  system: """
    You are an AI writing assistant embedded in TurboNotes, a desktop markdown editor.
    You help users write, edit, and organize their notes efficiently.

    Guidelines:
    - When summarizing, be concise but preserve all key information
    - When expanding, match the user's existing writing style and tone
    - When fixing grammar, make minimal changes — do not rewrite content unnecessarily
    - When generating outlines, create practical, actionable structures
    - When suggesting tags, focus on topic categorization, not generic terms
    - Always return valid markdown that can be inserted directly into the editor
    - If the user has text selected, operate on the selection; otherwise on the full note
    - Be aware of the note's context (word count, existing tags) to give relevant suggestions
    - Keep responses focused and actionable — this is a productivity tool, not a chatbot
    """

  tools: [
    summarize_text,
    expand_section,
    fix_grammar,
    generate_outline,
    suggest_tags,
    search_notes,
    get_current_note_context,
  ]

  memory: ConversationMemory(max_turns: 10)
  max_tokens: 4096
  temperature: 0.4
}

impl WritingAssistant {
  /// Create a new WritingAssistant bound to the app's shared state
  pub fn new(
    editor: Shared<Editor>,
    store: Shared<NoteStore>,
    search_index: Shared<SearchIndex>,
  ) -> WritingAssistant {
    let agent = WritingAssistant.init()
    agent.bind_context({ editor, store, search_index })
    agent
  }

  /// Summarize the current selection or full note
  pub async fn summarize(self) -> str ! AppError {
    let context = get_current_note_context()
    let text = context.selected_text ?? editor.read().content()

    let prompt = if context.has_selection {
      "Summarize this selected text in 2-3 sentences."
    } else {
      "Summarize this note in 3-5 sentences."
    }

    match await self.send("{prompt}\n\nText:\n{text}") {
      ok(response) => response.text
      err(e) => err(AppError.AgentError(e.message()))
    }
  }

  /// Expand the current selection
  pub async fn expand(self) -> str ! AppError {
    let selected = editor.read().snapshot().selected_text()

    guard let some(text) = selected else {
      return err(AppError.AgentError("No text selected. Select a section to expand."))
    }

    match await self.send("Expand this section into a more detailed version:\n\n{text}") {
      ok(response) => response.text
      err(e) => err(AppError.AgentError(e.message()))
    }
  }

  /// Fix grammar in the selection or full note
  pub async fn fix_grammar_action(self) -> str ! AppError {
    let context = get_current_note_context()
    let text = context.selected_text ?? editor.read().content()

    match await self.send("Fix all grammar, spelling, and punctuation errors. Preserve my writing style:\n\n{text}") {
      ok(response) => response.text
      err(e) => err(AppError.AgentError(e.message()))
    }
  }

  /// Generate an outline for a topic
  pub async fn generate_outline_action(self, topic: str? = none) -> str ! AppError {
    let effective_topic = topic ?? {
      let note_content = editor.read().content()
      Note.extract_title(note_content, Path.new(""))
    }

    match await self.send("Generate a detailed markdown outline for: {effective_topic}") {
      ok(response) => response.text
      err(e) => err(AppError.AgentError(e.message()))
    }
  }

  /// Suggest tags for the current note
  pub async fn suggest_tags_action(self) -> [str] ! AppError {
    let content = editor.read().content()

    match await self.send("Suggest 3-7 concise, relevant tags for this note. Return only the tags as a comma-separated list:\n\n{content}") {
      ok(response) => {
        response.text
          .split(',')
          .map((t) => t.trim().to_lowercase())
          .filter((t) => !t.is_empty())
          .collect()
      }
      err(e) => err(AppError.AgentError(e.message()))
    }
  }

  /// Stream a response for a custom prompt
  pub async fn custom_prompt(self, prompt: str) -> Stream<str> {
    let context = get_current_note_context()
    let full_prompt = if context.has_selection {
      "{prompt}\n\nSelected text:\n{context.selected_text.unwrap()}"
    } else {
      prompt
    }

    let token_stream = self.send_stream(full_prompt)

    async gen {
      for await token in token_stream {
        match token.kind {
          .text(t) => yield t
          .tool_call(name, _) => {
            log.debug("Agent calling tool", { tool: name })
          }
          .tool_result(_) => {
            log.debug("Tool returned result")
          }
          .done(usage) => {
            log.info("AI response complete", {
              tokens: usage.total,
              tool_calls: usage.tool_calls,
            })
          }
          _ => {}
        }
      }
    }
  }
}
