// Turbo File Analyzer — a real CLI tool
// Reads source files and produces detailed statistics:
// line counts, word frequency, complexity metrics, and language detection.
// Showcases: Result types, pattern matching, hashmaps, closures, pipes, string ops

struct FileStats {
    path: str,
    total_lines: i64,
    code_lines: i64,
    blank_lines: i64,
    comment_lines: i64,
    total_words: i64,
    unique_words: i64,
    avg_line_length: i64,
    longest_line: i64,
    language: str
}

fn detect_language(path: str) -> str {
    if ends_with(path, ".tb") {
        "Turbo"
    } else if ends_with(path, ".rs") {
        "Rust"
    } else if ends_with(path, ".py") {
        "Python"
    } else if ends_with(path, ".js") {
        "JavaScript"
    } else if ends_with(path, ".ts") {
        "TypeScript"
    } else if ends_with(path, ".c") {
        "C"
    } else if ends_with(path, ".go") {
        "Go"
    } else if ends_with(path, ".md") {
        "Markdown"
    } else {
        "Unknown"
    }
}

fn is_comment_line(line: str, lang: str) -> bool {
    let trimmed = trim(line)
    if lang == "Turbo" {
        starts_with(trimmed, "//")
    } else if lang == "Rust" {
        starts_with(trimmed, "//")
    } else if lang == "Python" {
        starts_with(trimmed, "#")
    } else if lang == "C" {
        starts_with(trimmed, "//") || starts_with(trimmed, "/*")
    } else if lang == "Go" {
        starts_with(trimmed, "//")
    } else if lang == "Markdown" {
        false
    } else {
        starts_with(trimmed, "//") || starts_with(trimmed, "#")
    }
}

fn analyze_file(path: str) -> FileStats ! str {
    let content = try_read_file(path)?
    let lang = detect_language(path)
    let lines = split(content, "\n")
    let total = lines.len()

    let mut code = 0
    let mut blank = 0
    let mut comments = 0
    let mut total_words = 0
    let mut longest = 0
    let mut total_len = 0
    let word_map = hashmap()

    for line in lines {
        let trimmed = trim(line)
        let line_len = len(trimmed)
        total_len += line_len

        if line_len > longest {
            longest = line_len
        }

        if line_len == 0 {
            blank += 1
        } else if is_comment_line(line, lang) {
            comments += 1
        } else {
            code += 1
        }

        let words = split(trimmed, " ")
        for w in words {
            let cleaned = lower(trim(w))
            if len(cleaned) > 0 {
                total_words += 1
                hashmap_set(word_map, cleaned, "1")
            }
        }
    }

    let avg = if total > 0 { total_len / total } else { 0 }

    ok(FileStats {
        path: path,
        total_lines: total,
        code_lines: code,
        blank_lines: blank,
        comment_lines: comments,
        total_words: total_words,
        unique_words: hashmap_len(word_map),
        avg_line_length: avg,
        longest_line: longest,
        language: lang
    })
}

fn print_bar(label: str, value: i64, max_val: i64) {
    let bar_width = 30
    let filled = if max_val > 0 { (value * bar_width) / max_val } else { 0 }
    let bar = repeat("#", filled) + repeat(".", bar_width - filled)
    print("  {label}  [{bar}] {value}")
}

fn print_stats(stats: FileStats) {
    print("")
    print(repeat("=", 56))
    print("  File Analyzer Report")
    print(repeat("=", 56))
    print("")
    print("  File:     {stats.path}")
    print("  Language: {stats.language}")
    print("")
    print(repeat("-", 56))
    print("  Line Breakdown")
    print(repeat("-", 56))

    let max_lines = stats.total_lines
    print_bar("Code    ", stats.code_lines, max_lines)
    print_bar("Comment ", stats.comment_lines, max_lines)
    print_bar("Blank   ", stats.blank_lines, max_lines)
    print("")
    print("  Total:          {stats.total_lines} lines")
    print("  Avg line length: {stats.avg_line_length} chars")
    print("  Longest line:    {stats.longest_line} chars")

    print("")
    print(repeat("-", 56))
    print("  Word Statistics")
    print(repeat("-", 56))
    print("  Total words:  {stats.total_words}")
    print("  Unique words: {stats.unique_words}")

    if stats.total_words > 0 {
        let ratio = (stats.unique_words * 100) / stats.total_words
        print("  Vocabulary:   {ratio}% unique")
    }

    let code_ratio = if stats.total_lines > 0 {
        (stats.code_lines * 100) / stats.total_lines
    } else {
        0
    }
    print("")
    print(repeat("-", 56))
    print("  Quality Metrics")
    print(repeat("-", 56))
    print("  Code density:    {code_ratio}%")

    if stats.comment_lines > 0 {
        let comment_ratio = (stats.comment_lines * 100) / stats.total_lines
        print("  Comment ratio:   {comment_ratio}%")
    } else {
        print("  Comment ratio:   0%")
    }

    if stats.avg_line_length > 100 {
        print("  Warning: avg line length > 100 — consider wrapping")
    }

    print("")
    print(repeat("=", 56))
    print("  Analysis complete!")
    print(repeat("=", 56))
}

fn main() {
    let files = [
        "examples/file-analyzer/main.tb",
        "turbo/crates/turbo-ast/src/lib.rs",
        "CHANGELOG.md"
    ]

    let mut analyzed = 0
    let mut failed = 0

    for file in files {
        match analyze_file(file) {
            ok(stats) => {
                print_stats(stats)
                analyzed += 1
            }
            err(e) => {
                print("Error: {e}")
                failed += 1
            }
        }
    }

    print("")
    print("Processed {analyzed} files, {failed} errors.")
}
