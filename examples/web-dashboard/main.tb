            + to_str(sorted[7]) + ", "
            + to_str(sorted[8]) + ", "
            + to_str(sorted[9])
            + "]\}")
    })

    // Sieve of Eratosthenes benchmark
    route(app, "GET", "/api/sieve", |req: str| -> str {
        let limit = 100000
        let count = sieve_count(limit)
        respond_json(200, "\{\"benchmark\": \"sieve_eratosthenes\", \"limit\": " + to_str(limit) + ", \"prime_count\": " + to_str(count) + "\}")
    })

    // Language info endpoint
    route(app, "GET", "/api/info", |req: str| -> str {
        respond_json(200, "\{\"language\": \"Turbo\", \"version\": \"1.0.0\", \"backend\": \"Cranelift\", \"features\": [\"JIT compilation\", \"AOT compilation\", \"async/await\", \"closures\", \"generics\", \"pattern matching\", \"HTTP server\", \"channels\", \"hashmaps\"]\}")
    })

    print("Dashboard ready. Press Ctrl+C to stop.")
    http_listen(app)
}
