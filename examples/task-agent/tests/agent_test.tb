// =============================================================================
// agent_test.tb — Tests for the AI agent with mocks
//
// Demonstrates:
//   - @mock decorator for mocking agent/LLM responses
//   - Testing tool function behavior without a real LLM
//   - Verifying agent tool selection and responses
//   - Testing streaming output
//   - Mocking patterns for AI-powered features
//   - for await on mocked streams
// =============================================================================

import { MockAgent, MockResponse } from "turbo/test"
import { Shared } from "turbo/sync"
import { TaskStore } from "../src/store"
import { TaskAssistant } from "../src/agent"
import { CreateTask, UpdateTask, TaskStatus, TaskError } from "../src/models"

// --- Test fixture ---

async fn setup_with_tasks() -> (TaskAssistant, Shared<TaskStore>) {
  let store = Shared.new(TaskStore.new())

  // Seed with representative tasks
  await store.write().create(CreateTask {
    title: "Fix login bug",
    priority: 1,
    tags: ["bug", "urgent"],
    assignee: some("Alice"),
  })?
  await store.write().create(CreateTask {
    title: "Add dark mode",
    priority: 3,
    tags: ["feature", "ui"],
    assignee: some("Bob"),
  })?
  await store.write().create(CreateTask {
    title: "Update dependencies",
    priority: 4,
    tags: ["maintenance"],
  })?
  await store.write().create(CreateTask {
    title: "Write API docs",
    priority: 2,
    tags: ["docs"],
    assignee: some("Charlie"),
  })?

  let agent = TaskAssistant.new(store: store.clone())
  (agent, store)
}

// ── Tool Function Tests (unit tests, no LLM needed) ──

@test
async fn test_tool_list_tasks_all() {
  let (_, store) = await setup_with_tasks()

  // Call the tool function directly (it is just a function)
  let tasks = await list_tasks()
  assert_eq(tasks.len(), 4)
}

@test
async fn test_tool_list_tasks_filtered() {
  let (_, store) = await setup_with_tasks()

  let bug_tasks = await list_tasks(status: some("todo"))
  assert_eq(bug_tasks.len(), 4)  // all are in "todo" status initially
}

@test
async fn test_tool_prioritize_task() {
  let (_, store) = await setup_with_tasks()

  let updated = await prioritize_task(id: 3, priority: 1)?
  assert_eq(updated.priority, 1)

  // Verify the change persisted
  let task = await store.read().get(3)?
  assert_eq(task.priority, 1)
}

@test
async fn test_tool_prioritize_task_invalid() {
  let (_, _) = await setup_with_tasks()

  match await prioritize_task(id: 1, priority: 0) {
    ok(_) => assert(false, "Should reject priority 0")
    err(TaskError.InvalidPriority(v)) => assert_eq(v, 0)
    err(e) => assert(false, "Wrong error: {e}")
  }
}

@test
async fn test_tool_suggest_next_task() {
  let (_, store) = await setup_with_tasks()

  let suggestion = await suggest_next_task()

  match suggestion {
    some(task) => {
      assert_eq(task.title, "Fix login bug")  // priority 1, the highest
      assert_eq(task.priority, 1)
    }
    none => assert(false, "Should suggest a task")
  }
}

@test
async fn test_tool_suggest_next_task_all_done() {
  let store = Shared.new(TaskStore.new())
  let id = await store.write().create(CreateTask { title: "Only task" })?
  await store.write().update(id, UpdateTask {
    status: some(TaskStatus.Done),
  })?

  let agent = TaskAssistant.new(store: store.clone())
  let suggestion = await suggest_next_task()

  assert_eq(suggestion, none)
}

@test
async fn test_tool_update_task_status() {
  let (_, store) = await setup_with_tasks()

  let updated = await update_task_status(id: 1, status: "in_progress")?
  assert_eq(updated.status, TaskStatus.InProgress)
}

@test
async fn test_tool_get_overdue_tasks() {
  let store = Shared.new(TaskStore.new())

  // Create a task with a past due date
  await store.write().create(CreateTask {
    title: "Overdue task",
    due_date: some(DateTime.parse("2024-01-01T00:00:00Z")),
  })?
  // Create a task with no due date
  await store.write().create(CreateTask {
    title: "No deadline",
  })?

  let agent = TaskAssistant.new(store: store.clone())
  let overdue = await get_overdue_tasks()

  assert_eq(overdue.len(), 1)
  assert_eq(overdue[0].title, "Overdue task")
}

@test
async fn test_tool_get_task_summary() {
  let (_, _) = await setup_with_tasks()

  let report = await get_task_summary()

  assert_eq(report.total, 4)
  assert_eq(report.done, 0)
  assert(report.by_status["todo"] == 4)
  assert(report.by_priority["P1"] == 1)
  assert(report.by_priority["P3"] == 1)
}

// ── Agent Integration Tests (with mocked LLM) ──

@test
@mock(agent: TaskAssistant, responses: [
  MockResponse {
    tool_calls: [
      { name: "list_tasks", args: {} }
    ],
    text: "You have 4 tasks. The highest priority is 'Fix login bug' (P1).",
  }
])
async fn test_agent_ask_lists_tasks() {
  let (agent, _) = await setup_with_tasks()

  let response = await agent.ask("What tasks do I have?")?

  assert(response.contains("4 tasks"))
  assert(response.contains("Fix login bug"))
}

@test
@mock(agent: TaskAssistant, responses: [
  MockResponse {
    tool_calls: [
      { name: "suggest_next_task", args: {} }
    ],
    text: "I suggest working on 'Fix login bug' — it's your highest priority task (P1) and tagged as urgent.",
  }
])
async fn test_agent_ask_suggests_task() {
  let (agent, _) = await setup_with_tasks()

  let response = await agent.ask("What should I work on next?")?

  assert(response.contains("Fix login bug"))
  assert(response.contains("P1") || response.contains("highest priority"))
}

@test
@mock(agent: TaskAssistant, responses: [
  MockResponse {
    tool_calls: [
      { name: "prioritize_task", args: { id: 3, priority: 2 } },
      { name: "prioritize_task", args: { id: 4, priority: 1 } },
    ],
    text: "I've reorganized your tasks. 'Write API docs' is now P1 and 'Update dependencies' is P2.",
  }
])
async fn test_agent_ask_organizes_tasks() {
  let (agent, store) = await setup_with_tasks()

  let response = await agent.ask("Please reprioritize: docs are more important than deps")?

  // Verify the agent's tool calls actually modified the store
  let docs_task = await store.read().get(4)?
  assert_eq(docs_task.priority, 1)

  let deps_task = await store.read().get(3)?
  assert_eq(deps_task.priority, 2)
}

// ── Streaming Tests ──

@test
@mock(agent: TaskAssistant, stream_responses: [
  ["You ", "have ", "4 ", "tasks. ", "Here's ", "a ", "summary..."],
])
async fn test_agent_stream() {
  let (agent, _) = await setup_with_tasks()

  let mut chunks: [str] = []
  for await chunk in agent.stream("Summarize my tasks") {
    chunks.push(chunk)
  }

  assert(chunks.len() > 0, "Should receive stream chunks")
  let full_response = chunks.join("")
  assert(full_response.contains("tasks"))
}

// ── Edge Cases ──

@test
async fn test_agent_with_empty_store() {
  let store = Shared.new(TaskStore.new())
  let agent = TaskAssistant.new(store: store.clone())

  let tasks = await list_tasks()
  assert_eq(tasks.len(), 0)

  let suggestion = await suggest_next_task()
  assert_eq(suggestion, none)
}

@test
async fn test_agent_tools_after_delete() {
  let (_, store) = await setup_with_tasks()

  // Delete all tasks
  for id in 1..=4 {
    await store.write().delete(id)?
  }

  // Tools should handle empty state gracefully
  let tasks = await list_tasks()
  assert_eq(tasks.len(), 0)

  let summary = await get_task_summary()
  assert_eq(summary.total, 0)
  assert_eq(summary.blocked_tasks, [])
}
