// =============================================================================
// routes.tb — HTTP routes for the Task Management REST API
//
// Demonstrates:
//   - REST API route definitions (GET, POST, PATCH, DELETE)
//   - Request parsing with req.json<T>() and req.params
//   - Response construction with status codes
//   - Error propagation with ? operator
//   - Pattern matching on results for error responses
//   - Shared<T> state access in route handlers
//   - AI agent integration via POST /tasks/organize
//   - Streaming AI responses via POST /tasks/chat
// =============================================================================

import { Router, Response, Request } from "turbo/http"
import { log } from "turbo/log"
import { Shared } from "turbo/sync"
import { Task, CreateTask, UpdateTask, TaskFilter, TaskError } from "./models"
import { TaskStore } from "./store"
import { TaskAssistant } from "./agent"

/// Build the application router with all routes
pub fn create_router(store: Shared<TaskStore>, agent: TaskAssistant) -> Router {
  let router = Router.new()

  // ── GET /tasks — List all tasks with optional filters ──

  router.get("/tasks", async (req) => {
    let filter = TaskFilter {
      status:   req.query.get("status"),
      priority: req.query.get("priority")?.parse<u8>(),
      assignee: req.query.get("assignee"),
      tag:      req.query.get("tag"),
      overdue:  req.query.get("overdue")?.parse<bool>(),
    }

    let tasks = await store.read().list(filter)
    log.debug("Listed tasks", { count: tasks.len() })
    Response.json(tasks)
  })

  // ── GET /tasks/stats — Get task statistics ──

  router.get("/tasks/stats", async (req) => {
    let stats = await store.read().stats()
    Response.json(stats)
  })

  // ── GET /tasks/:id — Get a single task by ID ──

  router.get("/tasks/:id", async (req) => {
    let id = req.params.id.parse<u64>()?

    match await store.read().get(id) {
      ok(task) => Response.json(task)
      err(TaskError.NotFound(_)) => Response.json(
        { error: "Task not found", id },
        status: 404
      )
      err(e) => Response.json(
        { error: e.message() },
        status: 500
      )
    }
  })

  // ── POST /tasks — Create a new task ──

  router.post("/tasks", async (req) => {
    let input = req.json<CreateTask>()?

    match await store.write().create(input) {
      ok(id) => {
        let task = await store.read().get(id)?
        log.info("Task created", { id, title: task.title })
        Response.json(task, status: 201)
      }
      err(TaskError.InvalidPriority(v)) => Response.json(
        { error: "Invalid priority: {v}", field: "priority" },
        status: 400
      )
      err(TaskError.ValidationError(field, reason)) => Response.json(
        { error: reason, field },
        status: 400
      )
      err(e) => Response.json(
        { error: e.message() },
        status: 500
      )
    }
  })

  // ── PATCH /tasks/:id — Update an existing task ──

  router.patch("/tasks/:id", async (req) => {
    let id = req.params.id.parse<u64>()?
    let changes = req.json<UpdateTask>()?

    match await store.write().update(id, changes) {
      ok(task) => {
        log.info("Task updated", { id, title: task.title })
        Response.json(task)
      }
      err(TaskError.NotFound(_)) => Response.json(
        { error: "Task not found", id },
        status: 404
      )
      err(TaskError.InvalidPriority(v)) => Response.json(
        { error: "Invalid priority: {v}" },
        status: 400
      )
      err(e) => Response.json(
        { error: e.message() },
        status: 500
      )
    }
  })

  // ── DELETE /tasks/:id — Delete a task ──

  router.delete("/tasks/:id", async (req) => {
    let id = req.params.id.parse<u64>()?

    match await store.write().delete(id) {
      ok(_) => {
        log.info("Task deleted", { id })
        Response.json({ deleted: true, id })
      }
      err(TaskError.NotFound(_)) => Response.json(
        { error: "Task not found", id },
        status: 404
      )
      err(e) => Response.json(
        { error: e.message() },
        status: 500
      )
    }
  })

  // ── POST /tasks/organize — Ask the AI agent to organize tasks ──

  router.post("/tasks/organize", async (req) => {
    let body = req.json<OrganizeRequest>()?
    let prompt = body.instruction ?? "Review all tasks and suggest better priorities and groupings."

    log.info("Agent organizing tasks", { prompt })

    match await agent.ask(prompt) {
      ok(response) => Response.json({
        message: response,
        organized: true,
      })
      err(e) => {
        log.error("Agent failed", { error: e.message() })
        Response.json(
          { error: "Agent error: {e.message()}" },
          status: 502
        )
      }
    }
  })

  // ── POST /tasks/chat — Stream a conversation with the AI agent ──

  router.post("/tasks/chat", async (req) => {
    let body = req.json<ChatRequest>()?

    log.info("Agent chat started", { message: body.message })

    // Return a Server-Sent Events stream
    Response.sse(agent.stream(body.message))
  })

  router
}

// --- Request body types ---

@derive(Schema)
struct OrganizeRequest {
  instruction: str? = none
}

@derive(Schema)
struct ChatRequest {
  message: str
}
