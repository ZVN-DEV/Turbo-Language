// =============================================================================
// store.tb — In-memory data store with thread-safe shared state
//
// Demonstrates:
//   - Shared<T> for thread-safe shared state (read/write locks)
//   - Mutable state with let mut
//   - Async functions with T ! E error returns
//   - Pattern matching for filtering
//   - Arrow functions in higher-order methods
//   - Guard statements for validation
//   - Pipe operator for data transformations
// =============================================================================

import { Shared } from "turbo/sync"
import { DateTime } from "std/time"
import { Task, CreateTask, UpdateTask, TaskStatus, TaskError, TaskFilter } from "./models"

// --- Internal store state ---

struct StoreState {
  tasks: {u64: Task}       // Map from ID to Task
  next_id: u64
}

// --- TaskStore (public API wrapping Shared<StoreState>) ---

pub struct TaskStore {
  state: Shared<StoreState>
}

impl TaskStore {
  /// Create a new empty task store
  pub fn new() -> TaskStore {
    TaskStore {
      state: Shared.new(StoreState {
        tasks: {:},
        next_id: 1,
      })
    }
  }

  /// Create a new task, returning its ID
  pub async fn create(self, input: CreateTask) -> u64 ! TaskError {
    // Validate priority
    guard input.priority >= 1 && input.priority <= 5 else {
      return err(TaskError.InvalidPriority(input.priority))
    }

    // Validate title is not empty
    guard !input.title.is_empty() else {
      return err(TaskError.ValidationError("title", "must not be empty"))
    }

    let mut s = self.state.write()
    let id = s.next_id
    s.next_id += 1

    let task = Task {
      id,
      title: input.title,
      description: input.description,
      status: TaskStatus.Todo,
      priority: input.priority,
      tags: input.tags,
      assignee: input.assignee,
      created_at: DateTime.now(),
      due_date: input.due_date,
    }

    s.tasks[id] = task
    id
  }

  /// Get a task by ID
  pub async fn get(self, id: u64) -> Task ! TaskError {
    let s = self.state.read()
    match s.tasks.get(id) {
      some(task) => task.clone()
      none       => err(TaskError.NotFound(id))
    }
  }

  /// List all tasks, optionally filtered
  pub async fn list(self, filter: TaskFilter = TaskFilter{}) -> [Task] {
    let s = self.state.read()
    let mut tasks: [Task] = s.tasks.values().collect()

    // Apply filters using pattern matching
    if let some(status_str) = filter.status {
      tasks = tasks.filter((t) => t.status.to_string() == status_str)
    }

    if let some(priority) = filter.priority {
      tasks = tasks.filter((t) => t.priority == priority)
    }

    if let some(assignee) = filter.assignee {
      tasks = tasks.filter((t) => t.assignee == some(assignee))
    }

    if let some(tag) = filter.tag {
      tasks = tasks.filter((t) => t.tags.contains(tag))
    }

    if let some(true) = filter.overdue {
      tasks = tasks.filter((t) => t.is_overdue())
    }

    // Sort by priority (ascending: 1 = highest priority first)
    tasks.sort_by((a, b) => a.priority.cmp(b.priority))
  }

  /// Update a task by ID with partial fields
  pub async fn update(self, id: u64, changes: UpdateTask) -> Task ! TaskError {
    let mut s = self.state.write()

    guard let some(task) = s.tasks.get(id) else {
      return err(TaskError.NotFound(id))
    }

    // Validate priority if provided
    if let some(p) = changes.priority {
      guard p >= 1 && p <= 5 else {
        return err(TaskError.InvalidPriority(p))
      }
    }

    // Apply each field if present (T? pattern matching)
    let updated = Task {
      ..task,
      title:       changes.title       ?? task.title,
      description: changes.description ?? task.description,
      status:      changes.status      ?? task.status,
      priority:    changes.priority    ?? task.priority,
      tags:        changes.tags        ?? task.tags,
      assignee:    changes.assignee    ?? task.assignee,
      due_date:    changes.due_date    ?? task.due_date,
    }

    s.tasks[id] = updated.clone()
    updated
  }

  /// Delete a task by ID
  pub async fn delete(self, id: u64) -> bool ! TaskError {
    let mut s = self.state.write()
    match s.tasks.remove(id) {
      some(_) => true
      none    => err(TaskError.NotFound(id))
    }
  }

  /// Count total tasks
  pub async fn count(self) -> u64 {
    self.state.read().tasks.len() as u64
  }

  /// Get tasks grouped by status (using pipe operator)
  pub async fn group_by_status(self) -> {str: [Task]} {
    let tasks = await self.list()
    tasks
      |> group_by((t) => t.status.to_string())
  }

  /// Get task statistics
  pub async fn stats(self) -> TaskStats {
    let tasks = await self.list()
    let total = tasks.len()
    let done = tasks.filter((t) => t.status == TaskStatus.Done).len()
    let overdue = tasks.filter((t) => t.is_overdue()).len()
    let avg_priority = if total > 0 {
      tasks.map((t) => t.priority as f64).sum() / total as f64
    } else {
      0.0
    }

    TaskStats { total, done, overdue, avg_priority }
  }
}

// --- TaskStats (returned by stats()) ---

@derive(Debug, Schema, Serialize)
struct TaskStats {
  total: usize
  done: usize
  overdue: usize
  avg_priority: f64
}
