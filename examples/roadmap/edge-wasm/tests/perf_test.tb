// =============================================================================
// perf_test.tb — Performance tests for the edge image processing pipeline
//
// Demonstrates:
//   - @perf decorator with max_memory and max_time constraints
//   - @stress decorator for concurrent load testing
//   - memory.snapshot() for tracking WASM memory usage
//   - Performance assertions with .ms(), .mb(), .kb() unit helpers
//   - Throughput measurement (images per second)
//   - WASM memory budget enforcement (must stay under 256MB)
//   - Latency measurement per transform operation
// =============================================================================

import { Stream } from "turbo/stream"
import { time } from "std/time"
import {
  ImageFormat, TransformOp, TransformPipeline, Dimensions,
  ResizeAlgorithm, ProcessingConfig, PipelineError,
} from "../src/models"
import { PipelineExecutor, PipelineBuilder, ImageChunk } from "../src/pipeline"
import { EdgeCache } from "../src/cache"
import {
  apply_resize, apply_crop, apply_blur, apply_sharpen,
  apply_grayscale, apply_brightness, apply_contrast, apply_flip,
} from "../src/transforms"
import { RequestArena, MemoryPool, GLOBAL_POOL } from "../src/wasm_bindings"

// --- Test fixtures ---

/// Generate a mock image stream of specified dimensions
fn mock_image(width: u32, height: u32) -> Stream<ImageChunk> {
  let rows_per_chunk = 64
  let mut current_row: u32 = 0

  async gen {
    while current_row < height {
      let chunk_rows = u32.min(rows_per_chunk, height - current_row)
      let data_size = chunk_rows as usize * width as usize * 4
      let mut data: [u8] = []
      data.reserve(data_size)

      for i in 0..data_size {
        data.push((i % 256) as u8)
      }

      yield ImageChunk {
        data,
        row_start: current_row,
        row_end: current_row + chunk_rows,
        width,
        channels: 4,
        is_last: current_row + chunk_rows >= height,
      }

      current_row += chunk_rows
    }
  }
}

// =============================================================================
// Per-Transform Latency Tests
// =============================================================================

@test
@perf(max_time: 500.ms(), max_memory: 50.mb())
async fn test_resize_latency_small() {
  // Resize a 1000x1000 image to 200x200
  let input = mock_image(1000, 1000)
  let target = Dimensions { width: 200, height: 200 }

  let start = time.now()
  let resized = input |> apply_resize(target, ResizeAlgorithm.Bilinear)

  let mut rows: u32 = 0
  for await chunk in resized {
    rows += chunk.row_count()
  }

  let elapsed = time.since(start).as_ms()
  assert_eq(rows, 200)
  assert(elapsed < 500.0, "Resize 1000x1000 -> 200x200 took {elapsed}ms (max 500ms)")
}

@test
@perf(max_time: 2.seconds(), max_memory: 100.mb())
async fn test_resize_latency_large() {
  // Resize a 4000x3000 image to 800x600
  let input = mock_image(4000, 3000)
  let target = Dimensions { width: 800, height: 600 }

  let start = time.now()
  let resized = input |> apply_resize(target, ResizeAlgorithm.Lanczos(window: 3))

  let mut rows: u32 = 0
  for await chunk in resized {
    rows += chunk.row_count()
  }

  let elapsed = time.since(start).as_ms()
  assert_eq(rows, 600)
  assert(elapsed < 2000.0, "Resize 4000x3000 -> 800x600 took {elapsed}ms (max 2000ms)")
}

