// =============================================================================
// editor.tb — Editor state management: cursor, selection, undo/redo, text ops
//
// Demonstrates:
//   - Mutable state with let mut and Shared<T>
//   - Undo/redo via immutable action stacks (no GC needed for snapshots)
//   - Pattern matching on algebraic data types
//   - Guard statements for boundary validation
//   - Pipe operator for text transformations
//   - Deterministic memory — no GC pauses during typing
//   - Expression-based control flow
// =============================================================================

import { DateTime, Duration } from "std/time"
import { Shared } from "turbo/sync"
import { log } from "turbo/log"
import {
  EditorState, CursorPosition, TextSelection, EditorMode,
  UndoAction, Direction, AppError
} from "./models"

// =============================================================================
// Constants
// =============================================================================

/// Maximum undo history depth before the oldest entries are dropped
const MAX_UNDO_DEPTH: usize = 500

/// Time window (ms) for coalescing consecutive keystrokes into a single undo entry
const COALESCE_WINDOW_MS: u64 = 400

/// Tab width in spaces
const TAB_WIDTH: usize = 4

// =============================================================================
// Editor — the core editing engine
// =============================================================================

pub struct Editor {
  state: Shared<EditorState>
  undo_stack: Shared<[UndoEntry]>
  redo_stack: Shared<[UndoEntry]>
  last_edit_time: Shared<DateTime?>
}

/// Internal undo entry: pairs an action with a timestamp for coalescing
struct UndoEntry {
  action: UndoAction
  timestamp: DateTime
  cursor_before: CursorPosition
  cursor_after: CursorPosition
}

impl Editor {
  /// Create an editor for new empty content
  pub fn new() -> Editor {
    Editor {
      state: Shared.new(EditorState.empty()),
      undo_stack: Shared.new([]),
      redo_stack: Shared.new([]),
      last_edit_time: Shared.new(none),
    }
  }

  /// Create an editor preloaded with content
  pub fn from_content(content: str) -> Editor {
    Editor {
      state: Shared.new(EditorState.from_content(content)),
      undo_stack: Shared.new([]),
      redo_stack: Shared.new([]),
      last_edit_time: Shared.new(none),
    }
  }

  /// Get a snapshot of the current editor state (read-only)
  pub fn snapshot(self) -> EditorState {
    self.state.read().clone()
  }

  /// Get the current content as a string
  pub fn content(self) -> str {
    self.state.read().content
  }

  /// Whether the buffer has unsaved modifications
  pub fn is_modified(self) -> bool {
    self.state.read().is_modified
  }

  /// Mark the buffer as saved (clears the modified flag)
  pub fn mark_saved(self) {
    self.state.write().is_modified = false
  }

  /// Replace entire content (used when loading a file). Clears undo history.
  pub fn load_content(self, content: str) {
    let mut s = self.state.write()
    s.content = content
    s.cursor = CursorPosition { line: 0, column: 0, offset: 0 }
    s.selection = none
    s.is_modified = false

    // Clear history — loading a file is not undoable
    self.undo_stack.write().clear()
    self.redo_stack.write().clear()
    self.last_edit_time.write() = none
  }

  // ===========================================================================
  // Text Operations
  // ===========================================================================

  /// Insert text at the current cursor position, replacing any selection
  pub fn insert_text(self, text: str) {
    let mut s = self.state.write()
    let cursor_before = s.cursor.clone()

    // If there is a selection, delete it first and record as a group
    let delete_action = match s.selection {
      some(sel) => {
        let (start, end) = sel.ordered()
        let deleted = s.content[start.offset..end.offset]
        s.content = "{s.content[..start.offset]}{s.content[end.offset..]}"
        s.cursor = start.clone()
        s.selection = none
        some(UndoAction.Delete(start.offset, deleted))
      }
      none => none
    }

    // Insert the new text
    let offset = s.cursor.offset
    s.content = "{s.content[..offset]}{text}{s.content[offset..]}"

    // Build the undo action
    let insert_action = UndoAction.Insert(offset, text)
    let action = match delete_action {
      some(del) => UndoAction.Group([del, insert_action])
      none      => insert_action
    }

    // Advance cursor past the inserted text
    let new_offset = offset + text.len()
    s.cursor = self.offset_to_position(s.content, new_offset)
    s.is_modified = true
    let cursor_after = s.cursor.clone()

    // Record undo with coalescing for consecutive single-character inserts
    drop(s)  // Release the write lock before pushing to undo
    self.push_undo(action, cursor_before, cursor_after)
  }

  /// Delete text in the given direction from the cursor
  pub fn delete(self, forward: bool) {
    let mut s = self.state.write()
    let cursor_before = s.cursor.clone()

    // If there is a selection, delete the selected text
    if let some(sel) = s.selection {
      let (start, end) = sel.ordered()
      let deleted = s.content[start.offset..end.offset]
      s.content = "{s.content[..start.offset]}{s.content[end.offset..]}"
      s.cursor = start.clone()
      s.selection = none
      s.is_modified = true
      let cursor_after = s.cursor.clone()
      let action = UndoAction.Delete(start.offset, deleted)

      drop(s)
      self.push_undo(action, cursor_before, cursor_after)
      return
    }

    // No selection — delete a single character
    let offset = s.cursor.offset
    if forward {
      // Delete (forward) — remove character after cursor
      guard offset < s.content.len() else { return }
      let ch = s.content[offset..offset + 1]
      s.content = "{s.content[..offset]}{s.content[offset + 1..]}"
      s.is_modified = true
      let cursor_after = s.cursor.clone()
      let action = UndoAction.Delete(offset, ch)

      drop(s)
      self.push_undo(action, cursor_before, cursor_after)
    } else {
      // Backspace — remove character before cursor
      guard offset > 0 else { return }
      let ch = s.content[offset - 1..offset]
      s.content = "{s.content[..offset - 1]}{s.content[offset..]}"
      let new_offset = offset - 1
      s.cursor = self.offset_to_position(s.content, new_offset)
      s.is_modified = true
      let cursor_after = s.cursor.clone()
      let action = UndoAction.Delete(new_offset, ch)

      drop(s)
      self.push_undo(action, cursor_before, cursor_after)
    }
  }

  /// Replace text in a given range with new text (for find-and-replace)
  pub fn replace_range(self, start: usize, end: usize, replacement: str) {
    let mut s = self.state.write()
    let cursor_before = s.cursor.clone()

    guard start <= end && end <= s.content.len() else {
      log.warn("replace_range: invalid range", { start, end, len: s.content.len() })
      return
    }

    let old_text = s.content[start..end]
    s.content = "{s.content[..start]}{replacement}{s.content[end..]}"
    let new_offset = start + replacement.len()
    s.cursor = self.offset_to_position(s.content, new_offset)
    s.selection = none
    s.is_modified = true
    let cursor_after = s.cursor.clone()

    let action = UndoAction.Replace(start, old_text, replacement)
    drop(s)
    self.push_undo(action, cursor_before, cursor_after)
  }

  /// Select all content
  pub fn select_all(self) {
    let mut s = self.state.write()
    let len = s.content.len()
    s.selection = some(TextSelection {
      anchor: CursorPosition { line: 0, column: 0, offset: 0 },
      focus: self.offset_to_position(s.content, len),
    })
    s.cursor = self.offset_to_position(s.content, len)
  }

  /// Clear current selection without deleting text
  pub fn clear_selection(self) {
    self.state.write().selection = none
  }

  // ===========================================================================
  // Cursor Movement
  // ===========================================================================

  /// Move the cursor in a direction, optionally extending the selection
  pub fn move_cursor(self, direction: Direction, extend_selection: bool) {
    let mut s = self.state.write()
    let old_cursor = s.cursor.clone()

    // Calculate new cursor position
    let new_cursor = match direction {
      Up       => self.cursor_up(s.content, s.cursor)
      Down     => self.cursor_down(s.content, s.cursor)
      Left     => self.cursor_left(s.content, s.cursor)
      Right    => self.cursor_right(s.content, s.cursor)
      Home     => CursorPosition { ..s.cursor, column: 0, offset: self.line_start_offset(s.content, s.cursor.line) }
      End      => {
        let line_end = self.line_end_offset(s.content, s.cursor.line)
        self.offset_to_position(s.content, line_end)
      }
      PageUp   => self.cursor_page_up(s.content, s.cursor)
      PageDown => self.cursor_page_down(s.content, s.cursor)
      DocStart => CursorPosition { line: 0, column: 0, offset: 0 }
      DocEnd   => self.offset_to_position(s.content, s.content.len())
    }

    s.cursor = new_cursor.clone()

    // Update selection
    if extend_selection {
      s.selection = match s.selection {
        some(sel) => some(TextSelection { anchor: sel.anchor, focus: new_cursor })
        none      => some(TextSelection { anchor: old_cursor, focus: new_cursor })
      }
    } else {
      s.selection = none
    }
  }

  // ===========================================================================
  // Undo / Redo
  // ===========================================================================

  /// Undo the last action. Returns true if an action was undone.
  pub fn undo(self) -> bool {
    let entry = {
      let mut stack = self.undo_stack.write()
      match stack.pop() {
        some(e) => e
        none    => return false
      }
    }

    // Apply the inverse action to the content
    self.apply_inverse(entry.action)

    // Restore cursor position
    self.state.write().cursor = entry.cursor_before.clone()

    // Push the inverse onto the redo stack
    self.redo_stack.write().push(UndoEntry {
      action: entry.action.inverse(),
      timestamp: entry.timestamp,
      cursor_before: entry.cursor_after,
      cursor_after: entry.cursor_before,
    })

    true
  }

  /// Redo a previously undone action. Returns true if an action was redone.
  pub fn redo(self) -> bool {
    let entry = {
      let mut stack = self.redo_stack.write()
      match stack.pop() {
        some(e) => e
        none    => return false
      }
    }

    // Apply the inverse of the inverse (i.e., the original action)
    self.apply_inverse(entry.action)

    // Restore cursor position
    self.state.write().cursor = entry.cursor_before.clone()

    // Push back onto the undo stack
    self.undo_stack.write().push(UndoEntry {
      action: entry.action.inverse(),
      timestamp: entry.timestamp,
      cursor_before: entry.cursor_after,
      cursor_after: entry.cursor_before,
    })

    true
  }

  /// Check whether undo is available
  pub fn can_undo(self) -> bool {
    self.undo_stack.read().len() > 0
  }

  /// Check whether redo is available
  pub fn can_redo(self) -> bool {
    self.redo_stack.read().len() > 0
  }

  // ===========================================================================
  // Markdown-Aware Helpers
  // ===========================================================================

  /// Insert a markdown heading at the current line
  pub fn insert_heading(self, level: u8) {
    guard level >= 1 && level <= 6 else { return }
    let prefix = "#".repeat(level as usize) ++ " "
    let s = self.state.read()
    let line_start = self.line_start_offset(s.content, s.cursor.line)

    // Check if the line already has a heading prefix and strip it
    let current_line = s.current_line()
    let stripped = if current_line.starts_with("#") {
      current_line.trim_start_matches('#').trim_start()
    } else {
      current_line
    }

    let line_end = self.line_end_offset(s.content, s.cursor.line)
    drop(s)

    self.replace_range(line_start, line_end, "{prefix}{stripped}")
  }

  /// Wrap the selection (or current word) with markdown formatting
  pub fn wrap_selection(self, before: str, after: str) {
    let s = self.state.read()
    match s.selection {
      some(sel) => {
        let (start, end) = sel.ordered()
        let selected = s.content[start.offset..end.offset]
        drop(s)
        self.replace_range(start.offset, end.offset, "{before}{selected}{after}")
      }
      none => {
        // No selection — insert markers and place cursor between them
        drop(s)
        self.insert_text("{before}{after}")
        // Move cursor back to between the markers
        let cursor = self.state.read().cursor.clone()
        let new_offset = cursor.offset - after.len()
        self.state.write().cursor = self.offset_to_position(
          self.state.read().content,
          new_offset,
        )
      }
    }
  }

  /// Toggle bold on the selection
  pub fn toggle_bold(self) {
    self.wrap_selection("**", "**")
  }

  /// Toggle italic on the selection
  pub fn toggle_italic(self) {
    self.wrap_selection("*", "*")
  }

  /// Toggle inline code on the selection
  pub fn toggle_code(self) {
    self.wrap_selection("`", "`")
  }

  /// Insert a markdown link template
  pub fn insert_link(self) {
    let s = self.state.read()
    match s.selected_text() {
      some(text) => {
        drop(s)
        self.replace_range(
          self.state.read().selection.unwrap().ordered().0.offset,
          self.state.read().selection.unwrap().ordered().1.offset,
          "[{text}](url)",
        )
      }
      none => {
        drop(s)
        self.insert_text("[link text](url)")
      }
    }
  }

  // ===========================================================================
  // Internal Helpers
  // ===========================================================================

  /// Push an undo action, coalescing with the previous entry if within the window
  fn push_undo(self, action: UndoAction, cursor_before: CursorPosition, cursor_after: CursorPosition) {
    let now = DateTime.now()

    // Clear redo stack on any new edit
    self.redo_stack.write().clear()

    // Attempt to coalesce consecutive single-character inserts
    let should_coalesce = {
      let last = self.last_edit_time.read()
      match last {
        some(t) => now.since(t).as_ms() < COALESCE_WINDOW_MS
        none    => false
      }
    }

    let mut stack = self.undo_stack.write()

    if should_coalesce && stack.len() > 0 {
      // Try to merge with the top entry
      let top = stack.last().unwrap()
      match (top.action, action) {
        (Insert(off1, t1), Insert(off2, t2)) if off2 == off1 + t1.len() => {
          // Consecutive inserts — merge into one
          let merged = UndoEntry {
            action: UndoAction.Insert(off1, "{t1}{t2}"),
            timestamp: now,
            cursor_before: top.cursor_before,
            cursor_after,
          }
          stack.pop()
          stack.push(merged)
          self.last_edit_time.write() = some(now)
          return
        }
        _ => {}
      }
    }

    // No coalescing — push as a new entry
    stack.push(UndoEntry { action, timestamp: now, cursor_before, cursor_after })

    // Trim history if over the limit
    if stack.len() > MAX_UNDO_DEPTH {
      stack.remove(0)
    }

    drop(stack)
    self.last_edit_time.write() = some(now)
  }

  /// Apply the inverse of an undo action to the content buffer
  fn apply_inverse(self, action: UndoAction) {
    let mut s = self.state.write()
    match action {
      Insert(offset, text) => {
        // Inverse of insert is delete
        s.content = "{s.content[..offset]}{s.content[offset + text.len()..]}"
      }
      Delete(offset, text) => {
        // Inverse of delete is insert
        s.content = "{s.content[..offset]}{text}{s.content[offset..]}"
      }
      Replace(offset, old_text, new_text) => {
        s.content = "{s.content[..offset]}{old_text}{s.content[offset + new_text.len()..]}"
      }
      Group(actions) => {
        // Apply each sub-action in reverse order
        for action in actions.reverse() {
          // Recurse — temporarily drop the write lock for nested apply
          drop(s)
          self.apply_inverse(action)
          s = self.state.write()
        }
      }
    }
    s.is_modified = true
  }

  /// Convert a byte offset to a CursorPosition (line, column, offset)
  fn offset_to_position(self, content: str, offset: usize) -> CursorPosition {
    let clamped = offset.min(content.len())
    let before = content[..clamped]
    let line = before.chars().filter((c) => c == '\n').count()
    let last_newline = before.rfind('\n').map((i) => i + 1) ?? 0
    let column = clamped - last_newline

    CursorPosition { line, column, offset: clamped }
  }

  /// Get the byte offset of the start of a given line
  fn line_start_offset(self, content: str, line: usize) -> usize {
    if line == 0 { return 0 }
    let mut current_line = 0
    for (i, ch) in content.chars().enumerate() {
      if ch == '\n' {
        current_line += 1
        if current_line == line {
          return i + 1
        }
      }
    }
    content.len()
  }

  /// Get the byte offset of the end of a given line (before the newline)
  fn line_end_offset(self, content: str, line: usize) -> usize {
    let start = self.line_start_offset(content, line)
    match content[start..].find('\n') {
      some(pos) => start + pos
      none      => content.len()
    }
  }

  /// Move cursor up one line, preserving column where possible
  fn cursor_up(self, content: str, cursor: CursorPosition) -> CursorPosition {
    guard cursor.line > 0 else { return cursor }
    let target_line = cursor.line - 1
    let line_start = self.line_start_offset(content, target_line)
    let line_end = self.line_end_offset(content, target_line)
    let line_len = line_end - line_start
    let new_column = cursor.column.min(line_len)
    let new_offset = line_start + new_column

    CursorPosition { line: target_line, column: new_column, offset: new_offset }
  }

  /// Move cursor down one line, preserving column where possible
  fn cursor_down(self, content: str, cursor: CursorPosition) -> CursorPosition {
    let total_lines = content.lines().count()
    guard cursor.line < total_lines - 1 else { return cursor }
    let target_line = cursor.line + 1
    let line_start = self.line_start_offset(content, target_line)
    let line_end = self.line_end_offset(content, target_line)
    let line_len = line_end - line_start
    let new_column = cursor.column.min(line_len)
    let new_offset = line_start + new_column

    CursorPosition { line: target_line, column: new_column, offset: new_offset }
  }

  /// Move cursor left by one character
  fn cursor_left(self, content: str, cursor: CursorPosition) -> CursorPosition {
    guard cursor.offset > 0 else { return cursor }
    self.offset_to_position(content, cursor.offset - 1)
  }

  /// Move cursor right by one character
  fn cursor_right(self, content: str, cursor: CursorPosition) -> CursorPosition {
    guard cursor.offset < content.len() else { return cursor }
    self.offset_to_position(content, cursor.offset + 1)
  }

  /// Move cursor up by one page (approximately 30 lines)
  fn cursor_page_up(self, content: str, cursor: CursorPosition) -> CursorPosition {
    let target_line = if cursor.line > 30 { cursor.line - 30 } else { 0 }
    let line_start = self.line_start_offset(content, target_line)
    let line_end = self.line_end_offset(content, target_line)
    let line_len = line_end - line_start
    let new_column = cursor.column.min(line_len)

    CursorPosition { line: target_line, column: new_column, offset: line_start + new_column }
  }

  /// Move cursor down by one page (approximately 30 lines)
  fn cursor_page_down(self, content: str, cursor: CursorPosition) -> CursorPosition {
    let total_lines = content.lines().count()
    let target_line = (cursor.line + 30).min(total_lines - 1)
    let line_start = self.line_start_offset(content, target_line)
    let line_end = self.line_end_offset(content, target_line)
    let line_len = line_end - line_start
    let new_column = cursor.column.min(line_len)

    CursorPosition { line: target_line, column: new_column, offset: line_start + new_column }
  }
}
