// =============================================================================
// main.tb — TurboNotes application entry point
//
// Demonstrates:
//   - Native window creation and event loop
//   - Event-driven architecture with a unified AppEvent type
//   - Top-level await for async initialization
//   - Shared<T> for thread-safe state shared between UI and background tasks
//   - defer for guaranteed cleanup on exit
//   - Pattern matching on event variants for dispatch
//   - Structured logging with turbo/log
//   - Configuration loading from environment + defaults
//   - Spawning background tasks (file watcher, auto-save, search indexing)
//   - Deterministic memory: no GC pauses during typing or rendering
// =============================================================================

import { Window, WindowConfig, EventLoop } from "turbo/ui"
import { log } from "turbo/log"
import { env } from "turbo/env"
import { Path } from "std/fs"
import { Shared } from "turbo/sync"
import { Channel } from "turbo/async"
import { Duration } from "std/time"
import { Editor } from "./editor"
import { NoteStore } from "./storage"
import { MarkdownParser, MarkdownRenderer } from "./markdown"
import { SearchIndex } from "./search"
import { WritingAssistant } from "./agent"
import { ShortcutHandler, KeyEvent } from "./shortcuts"
import { export_note } from "./export"
import {
  Note, AppEvent, AppError, EditorMode, Direction,
  ExportConfig, ExportFormat, SearchQuery, ConflictState
} from "./models"

// =============================================================================
// Configuration
// =============================================================================

@derive(Debug, Clone)
struct AppConfig {
  notes_dir: Path
  window_width: u32
  window_height: u32
  autosave_enabled: bool
  autosave_debounce_ms: u64
  autosave_interval_ms: u64
  log_level: str
  theme: str
}

fn load_config() -> AppConfig {
  let home = env.get("HOME") ?? "."
  AppConfig {
    notes_dir:           Path.new(env.get("TURBO_NOTES_DIR") ?? "{home}/TurboNotes"),
    window_width:        env.get("TURBO_WINDOW_WIDTH")?.parse::<u32>() ?? 1280,
    window_height:       env.get("TURBO_WINDOW_HEIGHT")?.parse::<u32>() ?? 800,
    autosave_enabled:    env.get("TURBO_AUTOSAVE")?.parse::<bool>() ?? true,
    autosave_debounce_ms: env.get("TURBO_AUTOSAVE_DEBOUNCE")?.parse::<u64>() ?? 500,
    autosave_interval_ms: env.get("TURBO_AUTOSAVE_INTERVAL")?.parse::<u64>() ?? 3000,
    log_level:           env.get("TURBO_LOG_LEVEL") ?? "info",
    theme:               env.get("TURBO_THEME") ?? "default",
  }
}

// =============================================================================
// Application State
// =============================================================================

/// All mutable application state, accessible from the event loop and background tasks
struct AppState {
  config: AppConfig
  editor: Shared<Editor>
  store: Shared<NoteStore>
  search_index: Shared<SearchIndex>
  shortcuts: ShortcutHandler
  agent: WritingAssistant
  current_note_id: Shared<str?>
  event_channel: Channel<AppEvent>
}

// =============================================================================
// Entry Point
// =============================================================================

async fn main() -> () ! Error {
  // Load configuration
  let config = load_config()

  // Initialize logging
  log.init(level: config.log_level, format: "pretty")
  log.info("Starting TurboNotes", {
    version: "0.1.0",
    notes_dir: config.notes_dir.to_str(),
  })

  // Initialize the note store (creates the directory if needed)
  let store = Shared.new(await NoteStore.new(config.notes_dir)?)

  // Build the search index from existing notes
  let notes = store.read().list_notes()
  let search_index = Shared.new(SearchIndex.build(notes))
  log.info("Search index built", { notes_indexed: notes.len() })

  // Create the editor
  let editor = Shared.new(Editor.new())

  // Initialize the AI writing assistant
  let agent = WritingAssistant.new(
    editor: editor.clone(),
    store: store.clone(),
    search_index: search_index.clone(),
  )
  log.info("AI writing assistant initialized")

  // Create the shortcut handler
  let shortcuts = ShortcutHandler.new()

  // Event channel for the main loop
  let event_channel = Channel.new(capacity: 1024)

  // Assemble application state
  let app = AppState {
    config,
    editor,
    store,
    search_index,
    shortcuts,
    agent,
    current_note_id: Shared.new(none),
    event_channel,
  }

  // Start the file watcher (background task)
  await app.store.write().start_watching()?

  // Pipe file system events into the main event channel
  spawn async {
    let fs_events = app.store.read().events()
    for await event in fs_events.receive() {
      app.event_channel.send(AppEvent.FileChanged(event))
    }
  }

  // Start auto-save (background task)
  if app.config.autosave_enabled {
    await app.store.read().start_autosave(
      debounce: Duration.from_ms(app.config.autosave_debounce_ms),
      interval: Duration.from_ms(app.config.autosave_interval_ms),
    )
    log.info("Auto-save enabled", {
      debounce_ms: app.config.autosave_debounce_ms,
      interval_ms: app.config.autosave_interval_ms,
    })
  }

  // Create the native window
  let window = Window.new(WindowConfig {
    title: "TurboNotes",
    width: app.config.window_width,
    height: app.config.window_height,
    min_width: 640,
    min_height: 480,
    resizable: true,
    decorations: true,
  })

  log.info("Window created", {
    width: app.config.window_width,
    height: app.config.window_height,
  })

  // Ensure clean shutdown
  defer {
    log.info("Shutting down TurboNotes")
    await app.store.read().shutdown()
  }

  // Open the most recently updated note, or create a welcome note
  let initial_notes = app.store.read().list_notes()
  if initial_notes.len() > 0 {
    let latest = initial_notes[0]  // Already sorted by updated_at desc
    await open_note(app, latest.id)?
  } else {
    // Create a welcome note for first-time users
    let welcome = await app.store.write().create_note("Welcome to TurboNotes")?
    await open_note(app, welcome.id)?
  }

  // ==========================================================================
  // Main Event Loop
  // ==========================================================================

  let event_loop = EventLoop.new(window)

  for await raw_event in event_loop.events() {
    // Convert raw window events to AppEvents via the shortcut handler
    let app_event = match raw_event {
      .keyboard(key_event) => app.shortcuts.handle(key_event)
      .paste(text) => some(AppEvent.Paste(text))
      .resize(w, h) => some(AppEvent.WindowResized(w, h))
      .close => some(AppEvent.WindowClosed)
      _ => none
    }

    // Also drain any events from background tasks (file watcher, AI responses)
    while let some(bg_event) = app.event_channel.try_receive() {
      dispatch_event(app, window, bg_event)
    }

    // Dispatch the UI event
    if let some(event) = app_event {
      let should_quit = dispatch_event(app, window, event)
      if should_quit { break }
    }

    // Re-render the editor view if content changed
    render(app, window)
  }

  log.info("TurboNotes exited cleanly")
}

// =============================================================================
// Event Dispatch — the core of the event-driven architecture
// =============================================================================

/// Dispatch a single AppEvent to the appropriate handler.
/// Returns true if the application should quit.
fn dispatch_event(app: AppState, window: Window, event: AppEvent) -> bool {
  match event {
    // ── File Operations ──

    NewNote => {
      spawn async {
        match await app.store.write().create_note("Untitled") {
          ok(note) => {
            await open_note(app, note.id)
              .unwrap_or_else((e) => log.error("Failed to open new note", { error: e.message() }))
          }
          err(e) => log.error("Failed to create note", { error: e.message() })
        }
      }
      false
    }

    OpenNote(path) => {
      let note_id = path.to_str().sha256()
      spawn async {
        await open_note(app, note_id)
          .unwrap_or_else((e) => log.error("Failed to open note", { error: e.message() }))
      }
      false
    }

    SaveNote => {
      spawn async { await save_current_note(app) }
      false
    }

    SaveNoteAs(path) => {
      spawn async { await save_note_as(app, path) }
      false
    }

    CloseNote(note_id) => {
      close_note(app, note_id)
      false
    }

    FileChanged(event) => {
      handle_file_change(app, event)
      false
    }

    // ── Editor Operations ──

    TextInput(text) => {
      app.editor.write().insert_text(text)
      queue_autosave(app)
      false
    }

    CursorMove(direction, extend_selection) => {
      app.editor.write().move_cursor(direction, extend_selection)
      false
    }

    SelectAll => {
      app.editor.write().select_all()
      false
    }

    DeleteSelection => {
      app.editor.write().delete(false)
      queue_autosave(app)
      false
    }

    Cut => {
      let selected = app.editor.read().snapshot().selected_text()
      if let some(text) = selected {
        window.set_clipboard(text)
        app.editor.write().delete(false)
        queue_autosave(app)
      }
      false
    }

    Copy => {
      let selected = app.editor.read().snapshot().selected_text()
      if let some(text) = selected {
        window.set_clipboard(text)
      }
      false
    }

    Paste(text) => {
      app.editor.write().insert_text(text)
      queue_autosave(app)
      false
    }

    Undo => {
      app.editor.write().undo()
      queue_autosave(app)
      false
    }

    Redo => {
      app.editor.write().redo()
      queue_autosave(app)
      false
    }

    // ── View ──

    SetMode(mode) => {
      app.editor.write().state.write().mode = mode
      false
    }

    ToggleSplitView => {
      let current = app.editor.read().snapshot().mode
      let new_mode = match current {
        SplitView => EditorMode.Normal
        _         => EditorMode.SplitView
      }
      app.editor.write().state.write().mode = new_mode
      false
    }

    OpenCommandPalette => {
      app.editor.write().state.write().mode = EditorMode.CommandPalette
      app.shortcuts.set_enabled(false)  // Disable shortcuts while palette is open
      false
    }

    ScrollTo(offset) => {
      app.editor.write().state.write().scroll_offset = offset
      false
    }

    // ── Search ──

    StartSearch => {
      app.editor.write().state.write().mode = EditorMode.Search
      false
    }

    SearchQuery(query) => {
      spawn async {
        let results = app.search_index.read().search(SearchQuery { text: query })
        match results {
          ok(results) => {
            log.debug("Search results", { count: results.len(), query })
            // Results would be rendered in the search panel
          }
          err(e) => log.warn("Search failed", { error: e.message() })
        }
      }
      false
    }

    CloseSearch => {
      app.editor.write().state.write().mode = EditorMode.Normal
      app.shortcuts.set_enabled(true)
      false
    }

    // ── AI Agent ──

    AiSummarize => {
      spawn async {
        match await app.agent.summarize() {
          ok(summary) => app.event_channel.send(AppEvent.AiResponseReceived(summary))
          err(e) => log.error("AI summarize failed", { error: e.message() })
        }
      }
      false
    }

    AiExpand => {
      spawn async {
        match await app.agent.expand() {
          ok(expanded) => {
            // Replace the selection with the expanded text
            let state = app.editor.read().snapshot()
            if let some(sel) = state.selection {
              let (start, end) = sel.ordered()
              app.editor.write().replace_range(start.offset, end.offset, expanded)
            }
          }
          err(e) => log.error("AI expand failed", { error: e.message() })
        }
      }
      false
    }

    AiFixGrammar => {
      spawn async {
        match await app.agent.fix_grammar_action() {
          ok(fixed) => {
            let state = app.editor.read().snapshot()
            match state.selection {
              some(sel) => {
                let (start, end) = sel.ordered()
                app.editor.write().replace_range(start.offset, end.offset, fixed)
              }
              none => {
                // Replace entire content
                app.editor.write().replace_range(0, state.content.len(), fixed)
              }
            }
          }
          err(e) => log.error("AI grammar fix failed", { error: e.message() })
        }
      }
      false
    }

    AiGenerateOutline => {
      spawn async {
        match await app.agent.generate_outline_action() {
          ok(outline) => {
            app.editor.write().insert_text(outline)
          }
          err(e) => log.error("AI outline generation failed", { error: e.message() })
        }
      }
      false
    }

    AiSuggestTags => {
      spawn async {
        match await app.agent.suggest_tags_action() {
          ok(tags) => {
            log.info("AI suggested tags", { tags: tags.join(", ") })
            // Tags would be displayed in the sidebar
          }
          err(e) => log.error("AI tag suggestion failed", { error: e.message() })
        }
      }
      false
    }

    AiCustomPrompt(prompt) => {
      spawn async {
        let stream = await app.agent.custom_prompt(prompt)
        let mut response = ""
        for await chunk in stream {
          response = "{response}{chunk}"
          // Stream chunks to the UI in real time
        }
        app.event_channel.send(AppEvent.AiResponseReceived(response))
      }
      false
    }

    AiResponseReceived(text) => {
      // Display the AI response — insert at cursor or show in a panel
      log.info("AI response received", { length: text.len() })
      false
    }

    // ── Export ──

    ExportHtml(path) => {
      spawn async { await handle_export(app, ExportFormat.Html, path) }
      false
    }

    ExportPdf(config) => {
      spawn async { await handle_export_with_config(app, config) }
      false
    }

    // ── Application Lifecycle ──

    WindowResized(width, height) => {
      log.debug("Window resized", { width, height })
      false
    }

    WindowClosed | Quit => {
      // Save any unsaved work before quitting
      if app.editor.read().is_modified() {
        spawn async { await save_current_note(app) }
      }
      true  // Signal the event loop to exit
    }

    _ => false
  }
}

// =============================================================================
// Helper Functions
// =============================================================================

/// Open a note by ID, loading its content into the editor
async fn open_note(app: AppState, note_id: str) -> () ! AppError {
  let note = match app.store.read().get_note(note_id) {
    some(n) => n
    none    => return err(AppError.InvalidState("Note not found: {note_id}"))
  }

  // Load content into the editor
  app.editor.write().load_content(note.content)
  app.current_note_id.write() = some(note_id)

  log.info("Opened note", { title: note.title, words: note.word_count() })
}

/// Save the currently open note
async fn save_current_note(app: AppState) {
  let note_id = match app.current_note_id.read().clone() {
    some(id) => id
    none     => return
  }

  let content = app.editor.read().content()
  match await app.store.write().save_note(note_id, content) {
    ok(_) => {
      app.editor.write().mark_saved()
      // Update the search index with the new content
      if let some(note) = app.store.read().get_note(note_id) {
        app.search_index.write().update_document(note)
      }
      log.debug("Note saved")
    }
    err(AppError.ConflictError(path, detail)) => {
      log.warn("Save conflict detected", { path: path.to_str(), detail })
      // Conflict resolution would trigger a UI dialog
    }
    err(e) => {
      log.error("Failed to save note", { error: e.message() })
    }
  }
}

/// Save the current note to a new path
async fn save_note_as(app: AppState, path: Path) {
  let content = app.editor.read().content()
  let title = Note.extract_title(content, path)
  match await app.store.write().create_note(title) {
    ok(note) => {
      await app.store.write().save_note(note.id, content)
        .unwrap_or_else((e) => log.error("Failed to save as", { error: e.message() }))
      app.current_note_id.write() = some(note.id)
      app.editor.write().mark_saved()
    }
    err(e) => log.error("Failed to create note for save-as", { error: e.message() })
  }
}

/// Close a note, prompting to save if modified
fn close_note(app: AppState, note_id: str) {
  if app.editor.read().is_modified() {
    // In a real app, show a save dialog here
    spawn async { await save_current_note(app) }
  }
  app.editor.write().load_content("")
  app.current_note_id.write() = none
}

/// Handle a file system change event
fn handle_file_change(app: AppState, event: FileEvent) {
  match event {
    FileEvent.Created(path) => {
      log.info("External file created", { path: path.to_str() })
      // Refresh the notes list in the sidebar
      let notes = app.store.read().list_notes()
      app.search_index.write() = SearchIndex.build(notes)
    }

    FileEvent.Modified(path, by_us) => {
      if !by_us {
        log.info("External file modification detected", { path: path.to_str() })
        // Check if this is the currently open note
        let current_id = app.current_note_id.read().clone()
        let file_id = path.to_str().sha256()

        if current_id == some(file_id) {
          // The currently open note was modified externally — trigger conflict check
          log.warn("Current note modified externally", { path: path.to_str() })
        }
      }
    }

    FileEvent.Deleted(path) => {
      log.info("External file deleted", { path: path.to_str() })
      let file_id = path.to_str().sha256()
      let current_id = app.current_note_id.read().clone()
      if current_id == some(file_id) {
        log.warn("Current note deleted externally")
      }
      app.search_index.write().remove_document(file_id)
    }

    FileEvent.Renamed(old_path, new_path) => {
      log.info("File renamed", {
        old: old_path.to_str(),
        new: new_path.to_str(),
      })
    }
  }
}

/// Queue the current note for auto-save
fn queue_autosave(app: AppState) {
  guard app.config.autosave_enabled else { return }
  let note_id = match app.current_note_id.read().clone() {
    some(id) => id
    none     => return
  }
  let content = app.editor.read().content()
  app.store.read().queue_autosave(note_id, content)
}

/// Handle an export operation
async fn handle_export(app: AppState, format: ExportFormat, path: Path) {
  let note_id = match app.current_note_id.read().clone() {
    some(id) => id
    none     => {
      log.warn("No note open for export")
      return
    }
  }

  let note = match app.store.read().get_note(note_id) {
    some(n) => n
    none    => {
      log.error("Note not found for export", { id: note_id })
      return
    }
  }

  let config = ExportConfig {
    format,
    output_path: path,
    include_metadata: true,
    syntax_highlight: true,
  }

  match await export_note(note, config) {
    ok(_)  => log.info("Export complete", { format: "{format}", path: path.to_str() })
    err(e) => log.error("Export failed", { error: e.message() })
  }
}

/// Handle export with a full config
async fn handle_export_with_config(app: AppState, config: ExportConfig) {
  let note_id = match app.current_note_id.read().clone() {
    some(id) => id
    none     => {
      log.warn("No note open for export")
      return
    }
  }

  let note = match app.store.read().get_note(note_id) {
    some(n) => n
    none    => return
  }

  match await export_note(note, config) {
    ok(_)  => log.info("Export complete")
    err(e) => log.error("Export failed", { error: e.message() })
  }
}

/// Render the current state to the window. Called after each event.
fn render(app: AppState, window: Window) {
  let state = app.editor.read().snapshot()

  match state.mode {
    Normal | SplitView => {
      // Render the markdown source in the editor pane
      window.render_text_editor(
        content: state.content,
        cursor: state.cursor,
        selection: state.selection,
        scroll_offset: state.scroll_offset,
      )

      // In split view, also render the HTML preview
      if state.mode == EditorMode.SplitView {
        let doc = MarkdownParser.parse(state.content)
        let html = MarkdownRenderer.render(doc)
        window.render_html_preview(html)
      }
    }

    Preview => {
      let doc = MarkdownParser.parse(state.content)
      let html = MarkdownRenderer.render(doc)
      window.render_html_preview(html)
    }

    CommandPalette => {
      let notes = app.store.read().list_notes()
      window.render_command_palette(notes)
    }

    Search => {
      window.render_search_panel()
    }

    AiPrompt => {
      window.render_ai_prompt_overlay()
    }
  }

  // Status bar: always visible
  let note_title = match app.current_note_id.read().clone() {
    some(id) => app.store.read().get_note(id).map((n) => n.title) ?? "Untitled"
    none     => "No note open"
  }

  let modified_indicator = if state.is_modified { " [modified]" } else { "" }
  let word_count = state.content.split_whitespace().count()
  let line_count = state.content.lines().count()

  window.render_status_bar(
    left: "{note_title}{modified_indicator}",
    center: "Ln {state.cursor.line + 1}, Col {state.cursor.column + 1}",
    right: "{word_count} words | {line_count} lines",
  )
}
