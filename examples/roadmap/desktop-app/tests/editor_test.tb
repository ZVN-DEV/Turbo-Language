// =============================================================================
// editor_test.tb — Tests for the editor state machine
//
// Demonstrates:
//   - @test decorator for test functions
//   - assert, assert_eq, assert_ne for assertions
//   - Testing undo/redo stack correctness
//   - Cursor movement boundary conditions
//   - Selection operations and text replacement
//   - Coalescing behavior for consecutive edits
//   - Edge cases: empty documents, end-of-file, multi-byte characters
// =============================================================================

import { Editor } from "../src/editor"
import {
  EditorState, CursorPosition, TextSelection, UndoAction, Direction
} from "../src/models"

// ── Basic Text Insertion ──

@test
fn test_insert_text_empty_document() {
  let editor = Editor.new()

  editor.insert_text("Hello")

  assert_eq(editor.content(), "Hello")
  assert_eq(editor.snapshot().cursor.offset, 5)
  assert_eq(editor.snapshot().cursor.column, 5)
  assert(editor.is_modified())
}

@test
fn test_insert_text_at_position() {
  let editor = Editor.from_content("Hello world")

  // Move cursor to position 5 (after "Hello")
  for _ in 0..5 {
    editor.move_cursor(Direction.Right, false)
  }

  editor.insert_text(",")

  assert_eq(editor.content(), "Hello, world")
}

@test
fn test_insert_multiline_text() {
  let editor = Editor.new()

  editor.insert_text("line 1\nline 2\nline 3")

  assert_eq(editor.content(), "line 1\nline 2\nline 3")
  assert_eq(editor.snapshot().cursor.line, 2)
  assert_eq(editor.snapshot().cursor.column, 6)
}

@test
fn test_insert_replaces_selection() {
  let editor = Editor.from_content("Hello world")

  // Select "world"
  editor.move_cursor(Direction.End, false)
  for _ in 0..5 {
    editor.move_cursor(Direction.Left, true)  // extend selection
  }

  editor.insert_text("Turbo")

  assert_eq(editor.content(), "Hello Turbo")
}

// ── Deletion ──

@test
fn test_backspace_single_character() {
  let editor = Editor.from_content("Hello")

  // Move to end
  editor.move_cursor(Direction.End, false)
  editor.delete(false)  // backspace

  assert_eq(editor.content(), "Hell")
}

@test
fn test_backspace_at_start_does_nothing() {
  let editor = Editor.from_content("Hello")

  // Cursor at start — backspace should be a no-op
  editor.delete(false)

  assert_eq(editor.content(), "Hello")
}

@test
fn test_forward_delete() {
  let editor = Editor.from_content("Hello")

  // Cursor at start — delete forward
  editor.delete(true)

  assert_eq(editor.content(), "ello")
}

@test
fn test_forward_delete_at_end_does_nothing() {
  let editor = Editor.from_content("Hello")

  editor.move_cursor(Direction.End, false)
  editor.delete(true)

  assert_eq(editor.content(), "Hello")
}

@test
fn test_delete_selection() {
  let editor = Editor.from_content("Hello beautiful world")

  // Select "beautiful "
  for _ in 0..6 { editor.move_cursor(Direction.Right, false) }
  for _ in 0..10 { editor.move_cursor(Direction.Right, true) }

  editor.delete(false)

  assert_eq(editor.content(), "Hello world")
}

// ── Cursor Movement ──

@test
fn test_cursor_right_and_left() {
  let editor = Editor.from_content("ABCDEF")

  editor.move_cursor(Direction.Right, false)
  editor.move_cursor(Direction.Right, false)
  editor.move_cursor(Direction.Right, false)

  assert_eq(editor.snapshot().cursor.offset, 3)
  assert_eq(editor.snapshot().cursor.column, 3)

  editor.move_cursor(Direction.Left, false)

  assert_eq(editor.snapshot().cursor.offset, 2)
}

@test
fn test_cursor_up_and_down() {
  let editor = Editor.from_content("Line 1\nLine 2\nLine 3")

  // Start at (0, 0), move down twice
  editor.move_cursor(Direction.Down, false)
  assert_eq(editor.snapshot().cursor.line, 1)

  editor.move_cursor(Direction.Down, false)
  assert_eq(editor.snapshot().cursor.line, 2)

  // Move back up
  editor.move_cursor(Direction.Up, false)
  assert_eq(editor.snapshot().cursor.line, 1)
}

@test
fn test_cursor_preserves_column_on_vertical_movement() {
  let editor = Editor.from_content("Long line here\nShort\nAnother long line")

  // Move to column 10 on line 0
  for _ in 0..10 { editor.move_cursor(Direction.Right, false) }
  assert_eq(editor.snapshot().cursor.column, 10)

  // Move down to "Short" (only 5 chars) — column should clamp
  editor.move_cursor(Direction.Down, false)
  assert_eq(editor.snapshot().cursor.line, 1)
  assert_eq(editor.snapshot().cursor.column, 5)  // Clamped to line length
}

@test
fn test_cursor_home_and_end() {
  let editor = Editor.from_content("Hello world")

  editor.move_cursor(Direction.End, false)
  assert_eq(editor.snapshot().cursor.column, 11)

  editor.move_cursor(Direction.Home, false)
  assert_eq(editor.snapshot().cursor.column, 0)
}

@test
fn test_cursor_doc_start_and_doc_end() {
  let editor = Editor.from_content("Line 1\nLine 2\nLine 3")

  editor.move_cursor(Direction.DocEnd, false)
  assert_eq(editor.snapshot().cursor.line, 2)
  assert_eq(editor.snapshot().cursor.offset, 20)

  editor.move_cursor(Direction.DocStart, false)
  assert_eq(editor.snapshot().cursor.line, 0)
  assert_eq(editor.snapshot().cursor.offset, 0)
}

@test
fn test_cursor_stays_in_bounds() {
  let editor = Editor.from_content("Hello")

  // Try to move left past the start
  editor.move_cursor(Direction.Left, false)
  assert_eq(editor.snapshot().cursor.offset, 0)

  // Try to move up past the first line
  editor.move_cursor(Direction.Up, false)
  assert_eq(editor.snapshot().cursor.line, 0)

  // Move to end, then try to go right past it
  editor.move_cursor(Direction.End, false)
  editor.move_cursor(Direction.Right, false)
  assert_eq(editor.snapshot().cursor.offset, 5)
}

// ── Selection ──

@test
fn test_select_by_shift_arrow() {
  let editor = Editor.from_content("Hello")

  // Shift+Right to select "Hel"
  editor.move_cursor(Direction.Right, true)
  editor.move_cursor(Direction.Right, true)
  editor.move_cursor(Direction.Right, true)

  let selection = editor.snapshot().selection
  assert(selection.is_some(), "Selection should exist")

  let sel = selection.unwrap()
  assert_eq(sel.anchor.offset, 0)
  assert_eq(sel.focus.offset, 3)
  assert_eq(editor.snapshot().selected_text(), some("Hel"))
}

@test
fn test_select_all() {
  let editor = Editor.from_content("Hello world")

  editor.select_all()

  assert_eq(editor.snapshot().selected_text(), some("Hello world"))
}

@test
fn test_moving_without_shift_clears_selection() {
  let editor = Editor.from_content("Hello")

  // Create a selection
  editor.move_cursor(Direction.Right, true)
  editor.move_cursor(Direction.Right, true)
  assert(editor.snapshot().selection.is_some())

  // Move without shift — should clear selection
  editor.move_cursor(Direction.Right, false)
  assert(editor.snapshot().selection.is_none())
}

@test
fn test_clear_selection() {
  let editor = Editor.from_content("Hello")

  editor.select_all()
  assert(editor.snapshot().selection.is_some())

  editor.clear_selection()
  assert(editor.snapshot().selection.is_none())
}

// ── Undo / Redo ──

@test
fn test_undo_insert() {
  let editor = Editor.new()

  editor.insert_text("Hello")
  assert_eq(editor.content(), "Hello")

  let undone = editor.undo()
  assert(undone)
  assert_eq(editor.content(), "")
}

@test
fn test_redo_after_undo() {
  let editor = Editor.new()

  editor.insert_text("Hello")
  editor.undo()
  assert_eq(editor.content(), "")

  let redone = editor.redo()
  assert(redone)
  assert_eq(editor.content(), "Hello")
}

@test
fn test_undo_delete() {
  let editor = Editor.from_content("Hello")

  editor.move_cursor(Direction.End, false)
  editor.delete(false)  // backspace removes 'o'

  assert_eq(editor.content(), "Hell")

  editor.undo()
  assert_eq(editor.content(), "Hello")
}

@test
fn test_undo_multiple_operations() {
  let editor = Editor.new()

  editor.insert_text("A")
  editor.insert_text("B")
  editor.insert_text("C")

  // Note: consecutive single chars may be coalesced into one undo entry
  // depending on timing. For test determinism, verify that undo reverses them.
  while editor.can_undo() {
    editor.undo()
  }

  assert_eq(editor.content(), "")
}

@test
fn test_redo_cleared_on_new_edit() {
  let editor = Editor.new()

  editor.insert_text("Hello")
  editor.undo()
  assert(editor.can_redo())

  // New edit should clear redo stack
  editor.insert_text("World")
  assert(!editor.can_redo())
}

@test
fn test_undo_with_no_history_returns_false() {
  let editor = Editor.new()

  assert(!editor.can_undo())
  assert(!editor.undo())
}

@test
fn test_redo_with_no_history_returns_false() {
  let editor = Editor.new()

  assert(!editor.can_redo())
  assert(!editor.redo())
}

@test
fn test_undo_replace_range() {
  let editor = Editor.from_content("Hello world")

  editor.replace_range(6, 11, "Turbo")
  assert_eq(editor.content(), "Hello Turbo")

  editor.undo()
  assert_eq(editor.content(), "Hello world")
}

// ── Markdown-Aware Operations ──

@test
fn test_toggle_bold() {
  let editor = Editor.from_content("some text here")

  // Select "text"
  for _ in 0..5 { editor.move_cursor(Direction.Right, false) }
  for _ in 0..4 { editor.move_cursor(Direction.Right, true) }

  editor.toggle_bold()

  assert_eq(editor.content(), "some **text** here")
}

@test
fn test_toggle_italic() {
  let editor = Editor.from_content("some text here")

  for _ in 0..5 { editor.move_cursor(Direction.Right, false) }
  for _ in 0..4 { editor.move_cursor(Direction.Right, true) }

  editor.toggle_italic()

  assert_eq(editor.content(), "some *text* here")
}

@test
fn test_toggle_code() {
  let editor = Editor.from_content("use this function")

  // Select "function"
  for _ in 0..9 { editor.move_cursor(Direction.Right, false) }
  for _ in 0..8 { editor.move_cursor(Direction.Right, true) }

  editor.toggle_code()

  assert_eq(editor.content(), "use this `function`")
}

@test
fn test_insert_heading() {
  let editor = Editor.from_content("My Title")

  editor.insert_heading(2)

  assert_eq(editor.content(), "## My Title")
}

@test
fn test_insert_link_with_selection() {
  let editor = Editor.from_content("click here please")

  // Select "here"
  for _ in 0..6 { editor.move_cursor(Direction.Right, false) }
  for _ in 0..4 { editor.move_cursor(Direction.Right, true) }

  editor.insert_link()

  assert_eq(editor.content(), "click [here](url) please")
}

// ── Load and Save State ──

@test
fn test_load_content_clears_undo_history() {
  let editor = Editor.new()

  editor.insert_text("some edits")
  assert(editor.can_undo())

  editor.load_content("fresh content")

  assert(!editor.can_undo())
  assert(!editor.can_redo())
  assert(!editor.is_modified())
  assert_eq(editor.content(), "fresh content")
}

@test
fn test_mark_saved_clears_modified_flag() {
  let editor = Editor.new()

  editor.insert_text("changes")
  assert(editor.is_modified())

  editor.mark_saved()
  assert(!editor.is_modified())
}

// ── Edge Cases ──

@test
fn test_empty_document_operations() {
  let editor = Editor.new()

  // All of these should be safe no-ops
  editor.delete(false)
  editor.delete(true)
  editor.move_cursor(Direction.Up, false)
  editor.move_cursor(Direction.Down, false)
  editor.move_cursor(Direction.Left, false)
  editor.move_cursor(Direction.Right, false)

  assert_eq(editor.content(), "")
  assert_eq(editor.snapshot().cursor.offset, 0)
}

@test
fn test_rapid_insert_delete_cycle() {
  let editor = Editor.new()

  // Simulate rapid typing and deleting
  for i in 0..100 {
    editor.insert_text("x")
    if i % 3 == 0 {
      editor.delete(false)
    }
  }

  // Should not crash, content length should be consistent
  let content = editor.content()
  assert(content.len() > 0, "Should have some content after inserts")
}

@test
fn test_select_all_then_type_replaces_entire_content() {
  let editor = Editor.from_content("Old content that should be replaced entirely")

  editor.select_all()
  editor.insert_text("New")

  assert_eq(editor.content(), "New")
}
