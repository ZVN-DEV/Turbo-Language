// =============================================================================
// api_test.tb — Integration tests for the HTTP API
//
// Demonstrates:
//   - Integration testing with MockServer
//   - HTTP client for sending test requests
//   - JSON response parsing and assertions
//   - Testing error responses and status codes
//   - Test fixtures with helper functions
//   - Destructuring in assertions
// =============================================================================

import { MockServer, TestClient } from "turbo/test"
import { Shared } from "turbo/sync"
import { TaskStore } from "../src/store"
import { create_router } from "../src/routes"
import { TaskAssistant } from "../src/agent"
import { CreateTask, TaskStatus } from "../src/models"

// --- Test fixture: create a test server and client ---

async fn setup() -> (TestClient, Shared<TaskStore>) {
  let store = Shared.new(TaskStore.new())
  let agent = TaskAssistant.new(store: store.clone())
  let router = create_router(store.clone(), agent)
  let server = MockServer.new(router)
  let client = server.client()
  (client, store)
}

// --- Helper: seed some tasks into the store ---

async fn seed_tasks(store: Shared<TaskStore>) -> [u64] {
  let ids = [
    await store.write().create(CreateTask {
      title: "Design API",
      priority: 1,
      tags: ["design"],
      assignee: some("Alice"),
    })?,
    await store.write().create(CreateTask {
      title: "Implement backend",
      priority: 2,
      tags: ["backend", "dev"],
      assignee: some("Bob"),
    })?,
    await store.write().create(CreateTask {
      title: "Write docs",
      priority: 3,
      tags: ["docs"],
    })?,
  ]
  ids
}

// ── GET /tasks ──

@test
async fn test_list_tasks_empty() {
  let (client, _) = await setup()

  let resp = await client.get("/tasks")

  assert_eq(resp.status, 200)
  let tasks = resp.json<[CreateTask]>()
  assert_eq(tasks.len(), 0)
}

@test
async fn test_list_tasks_with_data() {
  let (client, store) = await setup()
  await seed_tasks(store)

  let resp = await client.get("/tasks")

  assert_eq(resp.status, 200)
  let tasks = resp.json<[{str: any}]>()
  assert_eq(tasks.len(), 3)
  // Should be sorted by priority
  assert_eq(tasks[0]["title"], "Design API")
  assert_eq(tasks[1]["title"], "Implement backend")
}

@test
async fn test_list_tasks_filtered_by_assignee() {
  let (client, store) = await setup()
  await seed_tasks(store)

  let resp = await client.get("/tasks?assignee=Alice")

  assert_eq(resp.status, 200)
  let tasks = resp.json<[{str: any}]>()
  assert_eq(tasks.len(), 1)
  assert_eq(tasks[0]["title"], "Design API")
}

@test
async fn test_list_tasks_filtered_by_tag() {
  let (client, store) = await setup()
  await seed_tasks(store)

  let resp = await client.get("/tasks?tag=dev")

  assert_eq(resp.status, 200)
  let tasks = resp.json<[{str: any}]>()
  assert_eq(tasks.len(), 1)
  assert_eq(tasks[0]["title"], "Implement backend")
}

// ── GET /tasks/:id ──

@test
async fn test_get_task_by_id() {
  let (client, store) = await setup()
  let ids = await seed_tasks(store)

  let resp = await client.get("/tasks/{ids[0]}")

  assert_eq(resp.status, 200)
  let task = resp.json<{str: any}>()
  assert_eq(task["title"], "Design API")
  assert_eq(task["priority"], 1)
  assert_eq(task["assignee"], "Alice")
}

@test
async fn test_get_task_not_found() {
  let (client, _) = await setup()

  let resp = await client.get("/tasks/999")

  assert_eq(resp.status, 404)
  let body = resp.json<{str: any}>()
  assert_eq(body["error"], "Task not found")
}

// ── POST /tasks ──

@test
async fn test_create_task() {
  let (client, _) = await setup()

  let resp = await client.post("/tasks", json: {
    "title": "New task",
    "description": "A task created via API",
    "priority": 2,
    "tags": ["api", "test"],
    "assignee": "Charlie",
  })

  assert_eq(resp.status, 201)
  let task = resp.json<{str: any}>()
  assert_eq(task["title"], "New task")
  assert_eq(task["priority"], 2)
  assert_eq(task["assignee"], "Charlie")
  assert_eq(task["status"], "todo")
  assert(task["id"] != none, "Should have an ID")
}

@test
async fn test_create_task_with_defaults() {
  let (client, _) = await setup()

  let resp = await client.post("/tasks", json: {
    "title": "Minimal task",
  })

  assert_eq(resp.status, 201)
  let task = resp.json<{str: any}>()
  assert_eq(task["title"], "Minimal task")
  assert_eq(task["priority"], 3)       // default
  assert_eq(task["description"], "")   // default
  assert_eq(task["tags"], [])          // default
}

@test
async fn test_create_task_invalid_priority() {
  let (client, _) = await setup()

  let resp = await client.post("/tasks", json: {
    "title": "Bad task",
    "priority": 10,
  })

  assert_eq(resp.status, 400)
  let body = resp.json<{str: any}>()
  assert(body["error"].contains("Invalid priority"))
}

@test
async fn test_create_task_empty_title() {
  let (client, _) = await setup()

  let resp = await client.post("/tasks", json: {
    "title": "",
  })

  assert_eq(resp.status, 400)
  let body = resp.json<{str: any}>()
  assert_eq(body["field"], "title")
}

// ── PATCH /tasks/:id ──

@test
async fn test_update_task() {
  let (client, store) = await setup()
  let ids = await seed_tasks(store)

  let resp = await client.patch("/tasks/{ids[0]}", json: {
    "title": "Design API v2",
    "priority": 1,
    "status": "in_progress",
  })

  assert_eq(resp.status, 200)
  let task = resp.json<{str: any}>()
  assert_eq(task["title"], "Design API v2")
  assert_eq(task["status"], "in_progress")
}

@test
async fn test_update_task_not_found() {
  let (client, _) = await setup()

  let resp = await client.patch("/tasks/999", json: {
    "title": "Nope",
  })

  assert_eq(resp.status, 404)
}

@test
async fn test_update_task_invalid_priority() {
  let (client, store) = await setup()
  let ids = await seed_tasks(store)

  let resp = await client.patch("/tasks/{ids[0]}", json: {
    "priority": 0,
  })

  assert_eq(resp.status, 400)
}

// ── DELETE /tasks/:id ──

@test
async fn test_delete_task() {
  let (client, store) = await setup()
  let ids = await seed_tasks(store)

  let resp = await client.delete("/tasks/{ids[0]}")

  assert_eq(resp.status, 200)
  let body = resp.json<{str: any}>()
  assert_eq(body["deleted"], true)

  // Confirm it is gone
  let check = await client.get("/tasks/{ids[0]}")
  assert_eq(check.status, 404)
}

@test
async fn test_delete_task_not_found() {
  let (client, _) = await setup()

  let resp = await client.delete("/tasks/999")

  assert_eq(resp.status, 404)
}

// ── GET /tasks/stats ──

@test
async fn test_stats_endpoint() {
  let (client, store) = await setup()
  await seed_tasks(store)

  let resp = await client.get("/tasks/stats")

  assert_eq(resp.status, 200)
  let stats = resp.json<{str: any}>()
  assert_eq(stats["total"], 3)
  assert_eq(stats["done"], 0)
}

// ── POST /tasks/organize (agent endpoint) ──

@test
async fn test_organize_endpoint_returns_response() {
  let (client, store) = await setup()
  await seed_tasks(store)

  let resp = await client.post("/tasks/organize", json: {
    "instruction": "Prioritize the most important task",
  })

  // The agent should return a 200 with a message
  assert_eq(resp.status, 200)
  let body = resp.json<{str: any}>()
  assert(body["organized"] == true)
  assert(body["message"] != none, "Should have a response message")
}
