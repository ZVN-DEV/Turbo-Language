// =============================================================================
// store_test.tb — Unit tests for the TaskStore
//
// Demonstrates:
//   - @test decorator for test functions
//   - assert, assert_eq, assert_ne for assertions
//   - async test functions with await
//   - Pattern matching on T ! E results in tests
//   - Testing error cases with err() matching
//   - Concurrent access testing with all()
// =============================================================================

import { TaskStore } from "../src/store"
import { CreateTask, UpdateTask, TaskStatus, TaskError, TaskFilter } from "../src/models"
import { DateTime } from "std/time"

// ── CRUD Operations ──

@test
async fn test_create_task() {
  let store = TaskStore.new()

  let id = await store.create(CreateTask {
    title: "Write tests",
    description: "Add unit tests for the store",
    priority: 1,
    tags: ["testing", "dev"],
  })?

  assert_eq(id, 1)
  assert_eq(await store.count(), 1)
}

@test
async fn test_create_multiple_tasks() {
  let store = TaskStore.new()

  let id1 = await store.create(CreateTask { title: "First" })?
  let id2 = await store.create(CreateTask { title: "Second" })?
  let id3 = await store.create(CreateTask { title: "Third" })?

  assert_eq(id1, 1)
  assert_eq(id2, 2)
  assert_eq(id3, 3)
  assert_eq(await store.count(), 3)
}

@test
async fn test_get_task() {
  let store = TaskStore.new()
  let id = await store.create(CreateTask {
    title: "Read me",
    priority: 2,
    tags: ["important"],
    assignee: "Alice",
  })?

  let task = await store.get(id)?

  assert_eq(task.id, id)
  assert_eq(task.title, "Read me")
  assert_eq(task.priority, 2)
  assert_eq(task.tags, ["important"])
  assert_eq(task.assignee, some("Alice"))
  assert_eq(task.status, TaskStatus.Todo)
}

@test
async fn test_get_nonexistent_task() {
  let store = TaskStore.new()

  match await store.get(999) {
    ok(_) => assert(false, "Should have returned NotFound")
    err(TaskError.NotFound(id)) => assert_eq(id, 999)
    err(e) => assert(false, "Wrong error type: {e}")
  }
}

@test
async fn test_update_task() {
  let store = TaskStore.new()
  let id = await store.create(CreateTask { title: "Original" })?

  let updated = await store.update(id, UpdateTask {
    title: some("Updated"),
    priority: some(1),
    status: some(TaskStatus.InProgress),
    assignee: some("Bob"),
  })?

  assert_eq(updated.title, "Updated")
  assert_eq(updated.priority, 1)
  assert_eq(updated.status, TaskStatus.InProgress)
  assert_eq(updated.assignee, some("Bob"))
}

@test
async fn test_update_partial_fields() {
  let store = TaskStore.new()
  let id = await store.create(CreateTask {
    title: "Keep this",
    priority: 2,
    tags: ["preserve"],
  })?

  // Only update priority — other fields should remain unchanged
  let updated = await store.update(id, UpdateTask { priority: some(5) })?

  assert_eq(updated.title, "Keep this")
  assert_eq(updated.priority, 5)
  assert_eq(updated.tags, ["preserve"])
}

@test
async fn test_delete_task() {
  let store = TaskStore.new()
  let id = await store.create(CreateTask { title: "Delete me" })?

  assert_eq(await store.count(), 1)
  let deleted = await store.delete(id)?
  assert(deleted)
  assert_eq(await store.count(), 0)
}

@test
async fn test_delete_nonexistent() {
  let store = TaskStore.new()

  match await store.delete(42) {
    ok(_) => assert(false, "Should have returned NotFound")
    err(TaskError.NotFound(id)) => assert_eq(id, 42)
    err(_) => assert(false, "Wrong error type")
  }
}

// ── Validation ──

@test
async fn test_invalid_priority_zero() {
  let store = TaskStore.new()

  match await store.create(CreateTask { title: "Bad", priority: 0 }) {
    ok(_) => assert(false, "Should reject priority 0")
    err(TaskError.InvalidPriority(v)) => assert_eq(v, 0)
    err(_) => assert(false, "Wrong error type")
  }
}

@test
async fn test_invalid_priority_too_high() {
  let store = TaskStore.new()

  match await store.create(CreateTask { title: "Bad", priority: 10 }) {
    ok(_) => assert(false, "Should reject priority 10")
    err(TaskError.InvalidPriority(v)) => assert_eq(v, 10)
    err(_) => assert(false, "Wrong error type")
  }
}

@test
async fn test_empty_title_rejected() {
  let store = TaskStore.new()

  match await store.create(CreateTask { title: "" }) {
    ok(_) => assert(false, "Should reject empty title")
    err(TaskError.ValidationError(field, _)) => assert_eq(field, "title")
    err(_) => assert(false, "Wrong error type")
  }
}

@test
async fn test_update_invalid_priority() {
  let store = TaskStore.new()
  let id = await store.create(CreateTask { title: "Valid" })?

  match await store.update(id, UpdateTask { priority: some(99) }) {
    ok(_) => assert(false, "Should reject priority 99")
    err(TaskError.InvalidPriority(v)) => assert_eq(v, 99)
    err(_) => assert(false, "Wrong error type")
  }
}

// ── Filtering ──

@test
async fn test_filter_by_status() {
  let store = TaskStore.new()
  let id1 = await store.create(CreateTask { title: "Todo task" })?
  let id2 = await store.create(CreateTask { title: "Done task" })?

  await store.update(id2, UpdateTask { status: some(TaskStatus.Done) })?

  let todo_tasks = await store.list(TaskFilter { status: some("todo") })
  let done_tasks = await store.list(TaskFilter { status: some("done") })

  assert_eq(todo_tasks.len(), 1)
  assert_eq(todo_tasks[0].title, "Todo task")
  assert_eq(done_tasks.len(), 1)
  assert_eq(done_tasks[0].title, "Done task")
}

@test
async fn test_filter_by_assignee() {
  let store = TaskStore.new()
  await store.create(CreateTask { title: "Alice's task", assignee: some("Alice") })?
  await store.create(CreateTask { title: "Bob's task", assignee: some("Bob") })?
  await store.create(CreateTask { title: "Unassigned" })?

  let alice_tasks = await store.list(TaskFilter { assignee: some("Alice") })

  assert_eq(alice_tasks.len(), 1)
  assert_eq(alice_tasks[0].title, "Alice's task")
}

@test
async fn test_filter_by_tag() {
  let store = TaskStore.new()
  await store.create(CreateTask { title: "Bug fix", tags: ["bug", "urgent"] })?
  await store.create(CreateTask { title: "Feature", tags: ["feature"] })?
  await store.create(CreateTask { title: "Another bug", tags: ["bug"] })?

  let bugs = await store.list(TaskFilter { tag: some("bug") })

  assert_eq(bugs.len(), 2)
}

@test
async fn test_list_sorted_by_priority() {
  let store = TaskStore.new()
  await store.create(CreateTask { title: "Low", priority: 5 })?
  await store.create(CreateTask { title: "High", priority: 1 })?
  await store.create(CreateTask { title: "Medium", priority: 3 })?

  let tasks = await store.list()

  assert_eq(tasks[0].title, "High")
  assert_eq(tasks[1].title, "Medium")
  assert_eq(tasks[2].title, "Low")
}

// ── Statistics ──

@test
async fn test_stats() {
  let store = TaskStore.new()
  await store.create(CreateTask { title: "A", priority: 1 })?
  await store.create(CreateTask { title: "B", priority: 3 })?
  let id = await store.create(CreateTask { title: "C", priority: 5 })?

  await store.update(id, UpdateTask { status: some(TaskStatus.Done) })?

  let stats = await store.stats()

  assert_eq(stats.total, 3)
  assert_eq(stats.done, 1)
  assert_eq(stats.avg_priority, 3.0)
}

@test
async fn test_group_by_status() {
  let store = TaskStore.new()
  await store.create(CreateTask { title: "A" })?
  await store.create(CreateTask { title: "B" })?
  let id = await store.create(CreateTask { title: "C" })?
  await store.update(id, UpdateTask { status: some(TaskStatus.Done) })?

  let groups = await store.group_by_status()

  assert_eq(groups["todo"].len(), 2)
  assert_eq(groups["done"].len(), 1)
}

// ── Concurrent Access ──

@test
async fn test_concurrent_creates() {
  let store = TaskStore.new()

  // Create 100 tasks concurrently using all()
  let futures = (0..100).map((i) => {
    store.create(CreateTask { title: "Task {i}" })
  })

  let results = await all(futures)

  // All should succeed
  for result in results {
    assert(result.is_ok(), "Concurrent create should succeed")
  }

  assert_eq(await store.count(), 100)
}

@test
async fn test_concurrent_read_write() {
  let store = TaskStore.new()

  // Pre-populate some tasks
  for i in 0..10 {
    await store.create(CreateTask { title: "Existing {i}" })?
  }

  // Concurrent reads and writes
  let read_futures = (0..50).map((_) => store.list())
  let write_futures = (0..50).map((i) => {
    store.create(CreateTask { title: "Concurrent {i}" })
  })

  // Run reads and writes in parallel
  let [reads, writes] = await all([
    all(read_futures),
    all(write_futures),
  ])

  // All operations should complete without errors
  assert_eq(writes.filter((r) => r.is_ok()).len(), 50)
  assert_eq(await store.count(), 60)  // 10 original + 50 new
}

// ── Defaults ──

@test
async fn test_create_with_defaults() {
  let store = TaskStore.new()
  let id = await store.create(CreateTask { title: "Minimal" })?

  let task = await store.get(id)?

  assert_eq(task.title, "Minimal")
  assert_eq(task.description, "")
  assert_eq(task.priority, 3)         // default
  assert_eq(task.tags, [])            // default
  assert_eq(task.assignee, none)      // default
  assert_eq(task.due_date, none)      // default
  assert_eq(task.status, TaskStatus.Todo)
}
