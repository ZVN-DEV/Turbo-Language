@test
async fn test_search_bookmarks() {
  let app = await setup()
  let (_, token) = await register_user(app, "alice", "alice@example.com")

  await create_bookmark(app, token, "https://rust-lang.org", "The Rust Programming Language", tags: ["rust"])
  await create_bookmark(app, token, "https://turbo-lang.dev", "Turbo Language", tags: ["turbo"])
  await create_bookmark(app, token, "https://example.com", "Random Site", tags: ["misc"])

  let resp = await app.client.get("/api/v1/bookmarks/search?q=programming", headers: {
    "Authorization": "Bearer {token}"
  })

  assert_eq(resp.status, 200)
  let body = resp.json<{str: any}>()
  assert(body["total"] >= 1, "Should find at least one result for 'programming'")
}

