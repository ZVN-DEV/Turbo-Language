@test
async fn test_create_bookmark() {
  let app = await setup()
  let (_, token) = await register_user(app, "alice", "alice@example.com")

  let resp = await app.client.post("/api/v1/bookmarks", json: {
    "url": "https://turbo-lang.dev",
    "title": "Turbo Language",
    "description": "A modern programming language",
    "tags": ["programming", "language"],
    "notes": "Very interesting project",
  }, headers: { "Authorization": "Bearer {token}" })

  assert_eq(resp.status, 201)
  let bookmark = resp.json<{str: any}>()
  assert_eq(bookmark["url"], "https://turbo-lang.dev")
  assert_eq(bookmark["title"], "Turbo Language")
  assert_eq(bookmark["tags"], ["programming", "language"])
  assert(bookmark["id"] != none)
  assert(bookmark["created_at"] != none)
}

