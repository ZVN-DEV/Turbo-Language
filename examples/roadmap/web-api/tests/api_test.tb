// =============================================================================
// Logout Tests
// =============================================================================

@test
async fn test_logout_revokes_token() {
  let app = await setup()
  let (_, token) = await register_user(app, "alice", "alice@example.com")

  // Token should work before logout
  let resp1 = await app.client.get("/api/v1/bookmarks", headers: {
    "Authorization": "Bearer {token}"
  })
  assert_eq(resp1.status, 200)

  // Logout
  let logout_resp = await app.client.post("/auth/logout", headers: {
    "Authorization": "Bearer {token}"
  })
  assert_eq(logout_resp.status, 200)

  // Token should be rejected after logout
  let resp2 = await app.client.get("/api/v1/bookmarks", headers: {
    "Authorization": "Bearer {token}"
  })
  assert_eq(resp2.status, 401)
}

