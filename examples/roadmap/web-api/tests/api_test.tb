@test
async fn test_update_bookmark() {
  let app = await setup()
  let (_, token) = await register_user(app, "alice", "alice@example.com")
  let id = await create_bookmark(app, token, "https://example.com", "Original Title")

  let resp = await app.client.patch("/api/v1/bookmarks/{id}", json: {
    "title": "Updated Title",
    "tags": ["updated", "test"],
    "is_starred": true,
  }, headers: { "Authorization": "Bearer {token}" })

  assert_eq(resp.status, 200)
  let bookmark = resp.json<{str: any}>()
  assert_eq(bookmark["title"], "Updated Title")
  assert_eq(bookmark["tags"], ["updated", "test"])
  assert_eq(bookmark["is_starred"], true)
  // URL should remain unchanged
  assert_eq(bookmark["url"], "https://example.com")
}

@test
async fn test_update_bookmark_not_owned() {
  let app = await setup()
  let (_, alice_token) = await register_user(app, "alice", "alice@example.com")
  let (_, bob_token) = await register_user(app, "bob", "bob@example.com")

  let id = await create_bookmark(app, alice_token, "https://example.com", "Alice's Bookmark")

  // Bob tries to update Alice's bookmark
  let resp = await app.client.patch("/api/v1/bookmarks/{id}", json: {
    "title": "Stolen!",
  }, headers: { "Authorization": "Bearer {bob_token}" })

  assert_eq(resp.status, 403)
}

@test
async fn test_delete_bookmark() {
  let app = await setup()
  let (_, token) = await register_user(app, "alice", "alice@example.com")
  let id = await create_bookmark(app, token, "https://example.com", "Delete Me")

  let resp = await app.client.delete("/api/v1/bookmarks/{id}", headers: {
    "Authorization": "Bearer {token}"
  })

  assert_eq(resp.status, 200)
  let body = resp.json<{str: any}>()
  assert_eq(body["deleted"], true)

  // Confirm it is gone
  let check = await app.client.get("/api/v1/bookmarks/{id}", headers: {
    "Authorization": "Bearer {token}"
  })
  assert_eq(check.status, 404)
}

@test
async fn test_delete_bookmark_not_owned() {
  let app = await setup()
  let (_, alice_token) = await register_user(app, "alice", "alice@example.com")
  let (_, bob_token) = await register_user(app, "bob", "bob@example.com")

  let id = await create_bookmark(app, alice_token, "https://example.com", "Alice's")

  let resp = await app.client.delete("/api/v1/bookmarks/{id}", headers: {
    "Authorization": "Bearer {bob_token}"
  })

  assert_eq(resp.status, 403)
}

// =============================================================================
// Pagination Tests
// =============================================================================

@test
async fn test_list_bookmarks_paginated() {
  let app = await setup()
  let (_, token) = await register_user(app, "alice", "alice@example.com")

  // Create 25 bookmarks
  for i in 1..=25 {
    await create_bookmark(app, token, "https://example.com/{i}", "Bookmark {i}")
  }

  // Page 1 (default per_page = 20)
  let resp1 = await app.client.get("/api/v1/bookmarks?page=1&per_page=10", headers: {
    "Authorization": "Bearer {token}"
  })
  assert_eq(resp1.status, 200)
  let page1 = resp1.json<{str: any}>()
  assert_eq(page1["items"].len(), 10)
  assert_eq(page1["total"], 25)
  assert_eq(page1["page"], 1)
  assert_eq(page1["per_page"], 10)
  assert_eq(page1["total_pages"], 3)

  // Page 3 (should have 5 items)
  let resp3 = await app.client.get("/api/v1/bookmarks?page=3&per_page=10", headers: {
    "Authorization": "Bearer {token}"
  })
  assert_eq(resp3.status, 200)
  let page3 = resp3.json<{str: any}>()
  assert_eq(page3["items"].len(), 5)
  assert_eq(page3["page"], 3)
}

@test
async fn test_list_bookmarks_per_page_clamped() {
  let app = await setup()
  let (_, token) = await register_user(app, "alice", "alice@example.com")

  // Request per_page=500 — should be clamped to 100
  let resp = await app.client.get("/api/v1/bookmarks?per_page=500", headers: {
    "Authorization": "Bearer {token}"
  })
  assert_eq(resp.status, 200)
  let body = resp.json<{str: any}>()
  assert_eq(body["per_page"], 100)
}

