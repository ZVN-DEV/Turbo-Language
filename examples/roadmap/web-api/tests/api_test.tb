// =============================================================================
// api_test.tb — Integration tests for all HTTP endpoints
//
// Demonstrates:
//   - Integration testing with MockServer and TestClient
//   - Full request/response cycle testing
//   - JSON request body construction and response parsing
//   - Testing error responses and status codes
//   - Auth flow testing (register -> login -> use token)
//   - Pagination and search endpoint testing
//   - Test fixtures with helper functions
//   - Destructuring in assertions
// =============================================================================

import { MockServer, TestClient } from "turbo/test"
import { Router, Response, Request } from "turbo/http"
import { Shared } from "turbo/sync"
import { BookmarkStore, bookmark_routes } from "../src/routes/bookmarks"
import { UserStore, user_routes } from "../src/routes/users"
import { SyncBroadcaster, ws_routes } from "../src/routes/ws"
import { SearchEngine } from "../src/search"
import { TokenBlacklist, auth_required, sign_token } from "../src/auth"
import { Metrics } from "../src/middleware"
import { Visibility } from "../src/models"

// --- Test Fixtures ---

struct TestApp {
  client: TestClient
  user_store: Shared<UserStore>
  bookmark_store: Shared<BookmarkStore>
  blacklist: Shared<TokenBlacklist>
}

async fn setup() -> TestApp {
  let metrics = Shared.new(Metrics.new())
  let search = SearchEngine.new()
  let blacklist = Shared.new(TokenBlacklist.new())
  let user_store = Shared.new(UserStore.new())
  let bookmark_store = Shared.new(BookmarkStore.new(search))
  let broadcaster = Shared.new(SyncBroadcaster.new(metrics))

  let router = Router.new()

  // Public auth routes
  let auth_router = user_routes(user_store.clone(), blacklist.clone())
  router.mount("/", auth_router)

  // Protected routes
  let protected = Router.new()
  protected.use(auth_required(blacklist.clone()))
  let bm_router = bookmark_routes(bookmark_store.clone(), broadcaster.clone())
  protected.mount("/", bm_router)

  // Re-mount user profile routes under protected
  let profile_router = user_routes(user_store.clone(), blacklist.clone())
  protected.mount("/", profile_router)

  router.mount("/api/v1", protected)

  let server = MockServer.new(router)

  TestApp {
    client: server.client(),
    user_store: user_store,
    bookmark_store: bookmark_store,
    blacklist: blacklist,
  }
}

/// Register a user and return (user_id, auth_token_string)
async fn register_user(app: TestApp, username: str, email: str) -> (u64, str) {
  let resp = await app.client.post("/auth/register", json: {
    "username": username,
    "email": email,
    "password": "test_password_123",
    "display_name": username,
  })
  assert_eq(resp.status, 201)

  let body = resp.json<{str: any}>()
  let user_id = body["user"]["id"] as u64
  let token = body["token"]["access_token"] as str
  (user_id, token)
}

/// Create a bookmark using the API and return its ID
async fn create_bookmark(
  app: TestApp,
  token: str,
  url: str,
  title: str,
  tags: [str] = [],
) -> u64 {
  let resp = await app.client.post("/api/v1/bookmarks", json: {
    "url": url,
    "title": title,
    "tags": tags,
  }, headers: { "Authorization": "Bearer {token}" })

  assert_eq(resp.status, 201)
  let body = resp.json<{str: any}>()
  body["id"] as u64
}

// =============================================================================
// User Registration Tests
// =============================================================================

@test
async fn test_register_user() {
  let app = await setup()

  let resp = await app.client.post("/auth/register", json: {
    "username": "alice",
    "email": "alice@example.com",
    "password": "secure_password_123",
    "display_name": "Alice",
  })

  assert_eq(resp.status, 201)
  let body = resp.json<{str: any}>()
  assert_eq(body["user"]["username"], "alice")
  assert_eq(body["user"]["email"], "alice@example.com")
  assert_eq(body["user"]["display_name"], "Alice")
  assert(body["token"]["access_token"] != none, "Should include auth token")
  assert_eq(body["token"]["token_type"], "Bearer")
  // Password hash should NOT be in the response
  assert_eq(body["user"]["password_hash"], none)
}

@test
async fn test_register_duplicate_username() {
  let app = await setup()

  await app.client.post("/auth/register", json: {
    "username": "alice",
    "email": "alice@example.com",
    "password": "secure_password_123",
  })

  let resp = await app.client.post("/auth/register", json: {
    "username": "alice",
    "email": "alice2@example.com",
    "password": "another_password_123",
  })

  assert_eq(resp.status, 409)
  let body = resp.json<{str: any}>()
  assert(body["error"].contains("alice"), "Should mention the duplicate username")
}

@test
async fn test_register_validation_errors() {
  let app = await setup()

  let resp = await app.client.post("/auth/register", json: {
    "username": "ab",
    "email": "not-an-email",
    "password": "short",
  })

  assert_eq(resp.status, 422)
  let body = resp.json<{str: any}>()
  let errors = body["errors"] as [{str: any}]
  assert(errors.len() >= 3, "Should have validation errors for username, email, and password")
}

