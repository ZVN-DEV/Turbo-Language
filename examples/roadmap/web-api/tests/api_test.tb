// =============================================================================
// Cross-User Isolation Tests
// =============================================================================

@test
async fn test_users_see_only_own_bookmarks() {
  let app = await setup()
  let (_, alice_token) = await register_user(app, "alice", "alice@example.com")
  let (_, bob_token) = await register_user(app, "bob", "bob@example.com")

  // Alice creates 3 bookmarks
  for i in 1..=3 {
    await create_bookmark(app, alice_token, "https://alice.com/{i}", "Alice {i}")
  }

  // Bob creates 2 bookmarks
  for i in 1..=2 {
    await create_bookmark(app, bob_token, "https://bob.com/{i}", "Bob {i}")
  }

  // Alice sees only her 3
  let alice_resp = await app.client.get("/api/v1/bookmarks", headers: {
    "Authorization": "Bearer {alice_token}"
  })
  let alice_body = alice_resp.json<{str: any}>()
  assert_eq(alice_body["total"], 3)

  // Bob sees only his 2
  let bob_resp = await app.client.get("/api/v1/bookmarks", headers: {
    "Authorization": "Bearer {bob_token}"
  })
  let bob_body = bob_resp.json<{str: any}>()
  assert_eq(bob_body["total"], 2)
}

// =============================================================================
// Auth Required on All Protected Routes
// =============================================================================

@test
async fn test_protected_routes_require_auth() {
  let app = await setup()

  let endpoints = [
    ("GET", "/api/v1/bookmarks"),
    ("POST", "/api/v1/bookmarks"),
    ("GET", "/api/v1/bookmarks/1"),
    ("PATCH", "/api/v1/bookmarks/1"),
    ("DELETE", "/api/v1/bookmarks/1"),
    ("GET", "/api/v1/bookmarks/search?q=test"),
    ("GET", "/api/v1/bookmarks/tags"),
    ("GET", "/api/v1/users/me"),
    ("PATCH", "/api/v1/users/me"),
  ]

  for (method, path) in endpoints {
    let resp = match method {
      "GET"    => await app.client.get(path)
      "POST"   => await app.client.post(path, json: {})
      "PATCH"  => await app.client.patch(path, json: {})
      "DELETE" => await app.client.delete(path)
      _        => continue
    }

    assert_eq(resp.status, 401,
      "Expected 401 for {method} {path}, got {resp.status}")
  }
}
