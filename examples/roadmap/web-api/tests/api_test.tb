@test
async fn test_list_bookmarks_filter_starred() {
  let app = await setup()
  let (_, token) = await register_user(app, "alice", "alice@example.com")

  let id = await create_bookmark(app, token, "https://example.com/1", "Starred")
  await create_bookmark(app, token, "https://example.com/2", "Not Starred")

  // Star the first bookmark
  await app.client.patch("/api/v1/bookmarks/{id}", json: {
    "is_starred": true,
  }, headers: { "Authorization": "Bearer {token}" })

  let resp = await app.client.get("/api/v1/bookmarks?starred=true", headers: {
    "Authorization": "Bearer {token}"
  })

  assert_eq(resp.status, 200)
  let body = resp.json<{str: any}>()
  assert_eq(body["total"], 1)
  assert_eq(body["items"][0]["title"], "Starred")
}

