// =============================================================================
// Tag Cloud Tests
// =============================================================================

@test
async fn test_tag_cloud() {
  let app = await setup()
  let (_, token) = await register_user(app, "alice", "alice@example.com")

  await create_bookmark(app, token, "https://a.com", "A", tags: ["rust", "programming"])
  await create_bookmark(app, token, "https://b.com", "B", tags: ["rust", "web"])
  await create_bookmark(app, token, "https://c.com", "C", tags: ["programming", "turbo"])

  let resp = await app.client.get("/api/v1/bookmarks/tags", headers: {
    "Authorization": "Bearer {token}"
  })

  assert_eq(resp.status, 200)
  let tags = resp.json<[{str: any}]>()

  // "rust" appears in 2 bookmarks, "programming" in 2, "web" in 1, "turbo" in 1
  assert_eq(tags.len(), 4)
  // Should be sorted by count descending
  assert(tags[0]["count"] >= tags[1]["count"], "Tags should be sorted by count descending")
}

